<Application x:Class="ClipwellWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- Ressourcen werden per ApplyTheme() aktualisiert. -->
            <Thickness x:Key="EntryItemMargin">8,2</Thickness>
            <Thickness x:Key="EntryContentMargin">12,8</Thickness>
            <sys:Double x:Key="EntryMinHeight">52</sys:Double>
            <sys:Double x:Key="EntryFontSizeMain">12.5</sys:Double>
            <sys:Double x:Key="EntryFontSizeMeta">11</sys:Double>
            <Thickness x:Key="FilterChipPadding">10,4</Thickness>
            <sys:Double x:Key="FilterChipFontSize">11</sys:Double>
            <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#F21E1E2E" />
            <SolidColorBrush x:Key="PopupBorderBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="PopupPanelBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="PopupPanelBorderBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="PopupTextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PopupTextSecondaryBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="PopupTextMutedBrush" Color="#88FFFFFF" />
            <SolidColorBrush x:Key="PopupTextSubtleBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="PopupTextFaintBrush" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="PopupHoverBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="PopupSelectedBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="PopupChipBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="PopupChipCheckedBrush" Color="#44FFFFFF" />
            <SolidColorBrush x:Key="PopupBadgeBrush" Color="#2AFFFFFF" />
            <SolidColorBrush x:Key="PopupBadgeSecondaryBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="PopupShadowBrush" Color="#FF000000" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
