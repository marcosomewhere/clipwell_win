<Window x:Class="ClipwellWin.Views.CategoryDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kategorien analysieren – Ideenkombinat" Icon="/Merkautomat;component/Assets/kb-icon-16.png"
        Width="1000" Height="780" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EditorChromeBrush}" Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Kategorien analysieren" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource BrainCaption}" Margin="0,5,0,0"
                       Text="Merkautomat teilt deine Einträge ohne Kategorie nach Inhalt in Gruppen. Granite liest je Gruppe die typischsten Einträge und schlägt einen Kategorienamen vor. Du prüfst die Vorschläge; gespeichert wird erst mit „Übernehmen“. Danach schlägt E5 für neue Einträge selbst vor." />
            <TextBlock x:Name="ScopeText" Style="{StaticResource BrainCaption}" Margin="0,6,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource BrainCard}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                    <ProgressBar x:Name="Progress" Height="5" Margin="0,6,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="StartButton" Grid.Column="1" Content="Analyse starten" Click="Start_Click" Style="{StaticResource BrainPrimaryButton}" Margin="0,0,8,0" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="Abbrechen" Click="Cancel_Click" Style="{StaticResource EditorButtonStyle}" Visibility="Collapsed" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource BrainCard}" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock x:Name="ResultHeader" Text="Vorschläge" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource BrainCaption}" Margin="0,4,0,0"
                               Text="Jede Zeile ist eine Gruppe inhaltlich ähnlicher Einträge. Ist der Haken gesetzt, bekommen alle Einträge der Gruppe den Namen links als Kategorie. Namen lassen sich ändern; Gruppen ohne Namen oder mit unpassendem Inhalt einfach abgewählt lassen." />
                </StackPanel>
                <ListBox x:Name="ProposalList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource BrainListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Accepted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BrainSourceCheck}"
                                          VerticalAlignment="Top" Margin="0,8,0,0" Click="Accepted_Click" ToolTip="Diesen Vorschlag übernehmen" />
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="Kategorie für diese Gruppe" FontSize="11" Margin="0,0,0,4" Foreground="{DynamicResource EditorMutedBrush}" />
                                    <Grid>
                                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BrainInput}" MaxLength="80"
                                                 ToolTip="Kategoriename, frei änderbar" AutomationProperties.Name="Kategorie für diese Gruppe" TextChanged="Name_TextChanged" />
                                        <TextBlock Text="Name eintragen, z. B. Recherche" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   FontSize="13" Foreground="{DynamicResource EditorMutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding Kind}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource OnboardingAccentBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="11.5" Margin="0,3,0,6" Foreground="{DynamicResource EditorMutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding Examples}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Expander Header="Alle Einträge anzeigen" Margin="0,4,0,0" FontSize="11.5">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMore}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <TextBlock Text="{Binding AllTitles}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Feedback" Style="{StaticResource BrainCaption}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Grid.Column="1" Content="Schließen" IsCancel="True" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Grid.Column="2" Content="Ausgewählte übernehmen" Click="Apply_Click" Style="{StaticResource BrainPrimaryButton}" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
