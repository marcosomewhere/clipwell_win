<Window x:Class="ClipwellWin.Views.BrainRelationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wege und Beziehungen – Ideenkombinat" Icon="/Merkautomat;component/Assets/kb-icon-16.png"
        Width="1060" Height="800" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EditorChromeBrush}" Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="NodePicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="IsEditable" Value="True" />
                <Setter Property="IsTextSearchEnabled" Value="True" />
                <Setter Property="TextSearch.TextPath" Value="Label" />
                <Setter Property="ToolTip" Value="Titel eingeben oder einen Eintrag aus der Liste wählen" />
                <Setter Property="ItemTemplate">
                    <Setter.Value><DataTemplate>
                        <StackPanel MaxWidth="520" Margin="0,3">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Label}" />
                            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource EditorMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DataTemplate></Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Wege und Beziehungen" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="ScopeInfo" Style="{StaticResource BrainCaption}" Margin="0,5,0,0" />
        </StackPanel>
        <TabControl x:Name="RelationTabs" Grid.Row="1" SelectionChanged="Tabs_Changed">
            <TabItem Header="Weg finden">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource BrainCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1 · Start und Ziel wählen" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Start" Target="{Binding ElementName=PathFrom}" Padding="0,0,0,5" />
                                    <ComboBox x:Name="PathFrom" Style="{StaticResource NodePicker}" SelectionChanged="PathOptions_Changed" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Tauschen" Click="Swap_Click" Style="{StaticResource EditorButtonStyle}" VerticalAlignment="Bottom" Margin="10,0" />
                                <StackPanel Grid.Column="2">
                                    <Label Content="Ziel" Target="{Binding ElementName=PathTo}" Padding="0,0,0,5" />
                                    <ComboBox x:Name="PathTo" Style="{StaticResource NodePicker}" SelectionChanged="PathOptions_Changed" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Manuelle Beziehungen werden in Pfeilrichtung verfolgt. Zusätzlich berücksichtigen:" Style="{StaticResource BrainCaption}" Margin="0,12,0,8" />
                            <WrapPanel>
                                <CheckBox x:Name="IncludeSummary" Content="Quellen von Zusammenfassungen" IsChecked="True" Style="{StaticResource EditorCheckBoxStyle}" Margin="0,0,20,8" Click="PathOptions_Changed" />
                                <CheckBox x:Name="IncludeHints" Content="Automatische Hinweise" Style="{StaticResource EditorCheckBoxStyle}" Margin="0,0,0,8" Click="PathOptions_Changed" ToolTip="Nur aktive Bezugsarten aus dem Brain. Ähnlichkeit und zeitliche Nähe sind keine fachlichen Belege." />
                            </WrapPanel>
                            <Button x:Name="FindPathButton" Content="Kürzesten Weg finden" HorizontalAlignment="Left" Click="Find_Click" Style="{StaticResource PrimaryEditorButtonStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource BrainCard}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="2 · Verbindungen nachvollziehen" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Der kürzeste Weg zählt Verbindungen. Er beschreibt keine Arbeitszeit oder automatisch ausführbare Aufgabe." Style="{StaticResource BrainCaption}" Margin="0,5,0,0" />
                            </StackPanel>
                            <TextBox x:Name="PathResult" Style="{StaticResource BrainInput}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Beziehungen bearbeiten">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*" MinWidth="340"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource BrainCard}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock x:Name="RelationCount" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Button Content="Neue Beziehung" Click="New_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,0,10" />
                                <TextBox x:Name="RelationFilter" Style="{StaticResource BrainInput}" TextChanged="RelationFilter_Changed" AutomationProperties.Name="Beziehungen filtern" />
                                <TextBlock Text="Nach Titel, Typ oder Begründung filtern" Style="{StaticResource BrainCaption}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <Grid>
                                <ListBox x:Name="RelationsList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource BrainListItem}" SelectionChanged="Relation_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <StackPanel ToolTip="{Binding Label}">
                                            <TextBlock Text="{Binding Relation.Kind}" FontWeight="SemiBold" Foreground="{DynamicResource OnboardingAccentBrush}" Margin="0,0,0,5" />
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="RelationsEmpty" Text="Noch keine Beziehungen. Rechts Start, Ziel und Begründung eingeben." Style="{StaticResource BrainCaption}" Margin="8,16" VerticalAlignment="Top" IsHitTestVisible="False" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="{DynamicResource EditorBorderBrush}" />
                    <Border Grid.Column="2" Style="{StaticResource BrainCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="EditorHeading" Text="Neue Beziehung" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBlock Text="Start → Beziehung → Ziel. Die Begründung macht den Zusammenhang nachvollziehbar." Style="{StaticResource BrainCaption}" Margin="0,0,0,14" />
                                <Label Content="Start" Target="{Binding ElementName=RelationFrom}" Padding="0,0,0,5" />
                                <ComboBox x:Name="RelationFrom" Style="{StaticResource NodePicker}" Margin="0,0,0,12" SelectionChanged="Editor_Changed" />
                                <Label Content="Beziehungstyp" Target="{Binding ElementName=RelationKind}" Padding="0,0,0,5" />
                                <ComboBox x:Name="RelationKind" IsEditable="True" Margin="0,0,0,12" />
                                <Label Content="Ziel" Target="{Binding ElementName=RelationTo}" Padding="0,0,0,5" />
                                <ComboBox x:Name="RelationTo" Style="{StaticResource NodePicker}" Margin="0,0,0,12" SelectionChanged="Editor_Changed" />
                                <Label Content="Begründung / Quellenstelle (Pflicht)" Target="{Binding ElementName=Evidence}" Padding="0,0,0,5" />
                                <TextBox x:Name="Evidence" Style="{StaticResource BrainInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="76" MaxHeight="140" VerticalScrollBarVisibility="Auto" MaxLength="4000" Margin="0,0,0,12" TextChanged="Editor_Changed" />
                                <Expander Header="Aufgabe und Arbeitsschritte (optional)" Margin="0,0,0,12">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Beschreibungen zur Beziehung; es wird nichts automatisch ausgeführt." Style="{StaticResource BrainCaption}" Margin="0,0,0,8" />
                                        <TextBlock Text="Aufgabe" Margin="0,0,0,5" />
                                        <TextBox x:Name="TaskText" Style="{StaticResource BrainInput}" MaxLength="500" Margin="0,0,0,10" TextChanged="Editor_Changed" />
                                        <TextBlock Text="Arbeitsschritte (je Zeile ein Schritt)" Margin="0,0,0,5" />
                                        <TextBox x:Name="StepsText" Style="{StaticResource BrainInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="76" MaxHeight="160" VerticalScrollBarVisibility="Auto" MaxLength="8000" TextChanged="Editor_Changed" />
                                    </StackPanel>
                                </Expander>
                                <WrapPanel>
                                    <Button x:Name="ApplyRelationButton" Content="Zur Liste hinzufügen" Click="Apply_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" />
                                    <Button x:Name="RemoveRelationButton" Content="Entfernen" Click="Remove_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,0,8" IsEnabled="False" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Feedback" Style="{StaticResource BrainCaption}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CloseButton" Content="Schließen" IsCancel="True" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" />
                <Button x:Name="SaveRelationsButton" Content="Änderungen speichern" Click="Save_Click" Style="{StaticResource BrainPrimaryButton}" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
