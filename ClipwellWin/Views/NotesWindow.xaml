<Window x:Class="ClipwellWin.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merkautomat – Sprechwerk"
        Width="940" Height="640" MinWidth="620" MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="NoteButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PopupTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource PopupPanelBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{DynamicResource PopupBackgroundBrush}"
            BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="2" VerticalAlignment="Top" Margin="10,0,10,0"
                    Background="{DynamicResource AccentStripeBrush}"
                    IsHitTestVisible="False" Panel.ZIndex="1" />

            <!-- Kopfzeile -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    Background="{DynamicResource PopupPanelBrush}" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                        <TextBlock Text="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Sprechwerk" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource PopupTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NoteButton}" Click="New_Click" ToolTip="Neue Notiz (Strg+N)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Neu" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DictateButton" Style="{StaticResource NoteButton}" Click="Dictate_Click"
                                ToolTip="Diktieren starten/beenden (Strg+D). Text wird an der Cursorposition eingefügt.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DictateIcon" Text="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                           Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="DictateLabel" Text="Diktieren" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="KbButton" Style="{StaticResource NoteButton}" Click="ExportKb_Click"
                                ToolTip="Sprachnotiz als Markdown ins Ideenkombinat übernehmen (Strg+E)">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Clipwell;component/Assets/kb-icon-16.png" Width="16" Height="16" Margin="0,0,6,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBlock x:Name="KbLabel" Text="Ins Ideenkombinat" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Kopieren" Style="{StaticResource NoteButton}" Click="Copy_Click" />
                        <Button Content="Ordner öffnen" Style="{StaticResource NoteButton}" Click="OpenFolder_Click" />
                        <Button x:Name="DeleteButton" Content="Löschen" Style="{StaticResource NoteButton}" Click="Delete_Click" />
                    </StackPanel>
                    <Button Grid.Column="2" ToolTip="Schließen"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource PopupTextMutedBrush}" FontSize="13" Padding="6,2"
                            Click="Close_Click" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MinWidth="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" Margin="8,8,8,4" Padding="6,4" FontSize="12"
                             Background="{DynamicResource PopupPanelBrush}"
                             BorderBrush="{DynamicResource PopupPanelBorderBrush}"
                             Foreground="{DynamicResource PopupTextPrimaryBrush}"
                             CaretBrush="{DynamicResource PopupTextPrimaryBrush}"
                             ToolTip="Sprachnotizen durchsuchen"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchPlaceholder" Text="Suchen ..." Margin="16,12,0,0" FontSize="12"
                               IsHitTestVisible="False" Foreground="{DynamicResource PopupTextSubtleBrush}" />

                    <ListBox x:Name="NoteList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="NoteList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="6,2,6,2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PopupSelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PopupTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{DynamicResource PopupTextSubtleBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource PopupPanelBorderBrush}" />

                <Grid Grid.Column="2">
                    <TextBox x:Name="Editor"
                             TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="14,12"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PopupTextPrimaryBrush}"
                             CaretBrush="{DynamicResource PopupTextPrimaryBrush}"
                             TextChanged="Editor_TextChanged" />
                    <TextBlock x:Name="EditorPlaceholder" Margin="20,14,0,0" FontSize="13" IsHitTestVisible="False"
                               FontFamily="Cascadia Mono, Consolas"
                               Foreground="{DynamicResource PopupTextSubtleBrush}"
                               Text="Notiz schreiben oder mit &quot;Diktieren&quot; einsprechen ..." />
                </Grid>
            </Grid>

            <Border Grid.Row="2" Padding="10,6"
                    BorderBrush="{DynamicResource PopupPanelBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PopupTextSubtleBrush}" VerticalAlignment="Center" />
                    <StackPanel x:Name="DictationPanel" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Width="80" Height="6" CornerRadius="3" Margin="0,0,8,0"
                                Background="{DynamicResource PopupPanelBorderBrush}">
                            <Border x:Name="LevelBar" HorizontalAlignment="Left" Width="0" CornerRadius="3"
                                    Background="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock x:Name="DictationLabel" FontSize="11"
                                   Foreground="{DynamicResource PopupTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
