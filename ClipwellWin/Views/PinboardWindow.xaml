<Window x:Class="ClipwellWin.Views.PinboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Clipwell – Pinboard"
        Width="300" MinWidth="220" MaxWidth="480"
        Height="520" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="10"
            Background="#E8121220"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (Drag-Handle) -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    Background="#22FFFFFF" Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseDown"
                    Padding="10,6">
                <Grid>
                    <TextBlock Text="📌 Gepinnte Einträge"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="White" VerticalAlignment="Center" />
                    <Button Content="✕" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#88FFFFFF" FontSize="13" Padding="6,2"
                            Click="Close_Click" Cursor="Hand" />
                </Grid>
            </Border>

            <!-- Eintragsliste -->
            <ListBox x:Name="PinList" Grid.Row="1"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="PinList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="6,2,6,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="8,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PreviewText}"
                                           Foreground="White" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="36" ClipToBounds="True" />
                                <TextBlock Text="{Binding RelativeTime}"
                                           Foreground="#88FFFFFF" FontSize="10"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="↩" ToolTip="Einfügen"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#88FFFFFF" FontSize="14" Padding="6,0"
                                    Click="PasteBtn_Click" Cursor="Hand"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Fusszeile -->
            <Border Grid.Row="2" Padding="8,6"
                    BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                <TextBlock x:Name="CountLabel"
                           Foreground="#88FFFFFF" FontSize="11"
                           HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
