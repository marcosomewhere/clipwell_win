<Window x:Class="ClipwellWin.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipwell - Willkommen"
        Width="760" Height="620"
        MinWidth="720" MinHeight="580"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        SourceInitialized="Window_SourceInitialized"
        Background="{DynamicResource OnboardingBackgroundBrush}"
        Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnboardingTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OnboardingSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OnboardingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource OnboardingInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OnboardingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="{DynamicResource OnboardingAccentBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OnboardingInputFocusedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource OnboardingButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnboardingButtonTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OnboardingButtonBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OnboardingButtonHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnboardingButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Willkommen bei Clipwell"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <TextBlock Text="Richte den globalen Hotkey ein. Danach läuft Clipwell im Infobereich neben der Uhr."
                       FontSize="13"
                       Style="{StaticResource MutedText}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Hotkey"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Klicke ins Feld und drücke die gewünschte Tastenkombination."
                                   FontSize="12"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>

                    <TextBox x:Name="HotkeyRecorderBox"
                             Grid.Row="1"
                             Height="42"
                             Padding="12,9"
                             FontSize="15"
                             FontWeight="SemiBold"
                             IsReadOnly="True"
                             PreviewKeyDown="HotkeyRecorderBox_PreviewKeyDown"
                             GotKeyboardFocus="HotkeyRecorderBox_GotKeyboardFocus"
                             LostKeyboardFocus="HotkeyRecorderBox_LostKeyboardFocus" />

                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,12,0,0">
                        <CheckBox x:Name="ModWin" Content="Win" Margin="0,0,8,0" Click="Modifier_Click" />
                        <CheckBox x:Name="ModShift" Content="Shift" Margin="0,0,8,0" Click="Modifier_Click" />
                        <CheckBox x:Name="ModCtrl" Content="Ctrl" Margin="0,0,8,0" Click="Modifier_Click" />
                        <CheckBox x:Name="ModAlt" Content="Alt" Click="Modifier_Click" />
                    </UniformGrid>

                    <StackPanel Grid.Row="3" Margin="0,22,0,0">
                        <TextBlock Text="Aktion beim Hotkey"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <RadioButton x:Name="OpenMenuRadio"
                                     GroupName="HotkeyAction"
                                     Content="Clipboard-Menü öffnen"
                                     Checked="HotkeyAction_Checked" />
                        <RadioButton x:Name="PasteLatestRadio"
                                     GroupName="HotkeyAction"
                                     Content="Neuesten Eintrag direkt einfügen"
                                     Checked="HotkeyAction_Checked" />
                        <CheckBox x:Name="StartWithWindowsCheck"
                                  Content="Mit Windows starten"
                                  Margin="0,8,0,0"
                                  Click="StartWithWindows_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                        <Button x:Name="SaveHotkeyBtn"
                                Content="Hotkey speichern"
                                Height="36"
                                Click="SaveHotkey_Click"
                                Margin="0,0,0,10" />
                        <Button x:Name="TestHotkeyBtn"
                                Content="Hotkey testen"
                                Height="36"
                                Click="TestHotkey_Click" />
                        <TextBlock x:Name="HotkeyStatusLabel"
                                   Foreground="{DynamicResource OnboardingTextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   MinHeight="34" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Speichert lokal"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Texte, URLs, Code, Farben und Bilder bleiben auf deinem Rechner."
                                   FontSize="12"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Schneller Zugriff"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Der Hotkey öffnet die Suche oder fügt den neuesten Eintrag direkt ein."
                                   FontSize="12"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Tray-App"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Nach dem Start findest du Clipwell im Infobereich. Rechtsklick öffnet Menü, Einstellungen und Beenden."
                                   FontSize="12"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusLabel"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource OnboardingTextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Einstellungen"
                        MinWidth="116"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="OpenSettings_Click" />
                <Button Content="Fertig"
                        MinWidth="116"
                        Height="38"
                        FontWeight="SemiBold"
                        Click="Finish_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
