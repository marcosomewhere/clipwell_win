<Window x:Class="ClipwellWin.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipwell – Willkommen"
        Width="480" Height="540"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Kopf ───────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Willkommen bei Clipwell"
                       FontSize="24" FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBlock Text="Dein lokaler Clipboard-Manager für Windows. Hier ist ein kurzer Überblick."
                       FontSize="13" Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- ── Features ───────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Background="#0A000000" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="HotkeyLabel"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Öffnet das Clipboard-Menü von überall."
                                   FontSize="12" Opacity="0.7" Margin="0,0,0,10" />
                        <Button x:Name="TestHotkeyBtn"
                                Content="Hotkey testen (jetzt drücken)"
                                Padding="12,6" FontSize="12"
                                Click="TestHotkey_Click"
                                HorizontalAlignment="Left" />
                        <TextBlock x:Name="HotkeyResultLabel"
                                   FontSize="12" Margin="0,8,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Background="#0A000000" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="&#x2714; Was wird gespeichert?" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock FontSize="12" Opacity="0.75" LineHeight="22" TextWrapping="Wrap">
Texte, URLs mit Vorschau und Favicon, Code mit Syntax-Highlighting,&#x0a;Farben (#hex) und Bilder mit optionalem OCR-Text.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="#0A000000" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="&#x2714; Suche und Filterung" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock FontSize="12" Opacity="0.75" LineHeight="22" TextWrapping="Wrap">
Echtzeit-Suche über alle Einhalte.&#x0a;Filter-Chips für Typ (Text/Code/URL/Bild/Farbe).&#x0a;Erweiterte Präfixe: type:url, kind:json, domain:github.com, pinned:true
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="#0A000000" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="&#x2714; Datenschutz" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock FontSize="12" Opacity="0.75" LineHeight="22" TextWrapping="Wrap">
Alles bleibt lokal – keine Cloud, kein Tracking.&#x0a;Inkognito-Modus für Apps oder Domains.&#x0a;Automatisches Erkennen und Überspringen von API-Keys, Tokens und Passwörtern.
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Fußzeile ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Einstellungen öffnen"
                    Padding="12,8" FontSize="13" Margin="0,0,12,0"
                    Click="OpenSettings_Click" />
            <Button Content="Los geht's!"
                    Padding="24,8" FontSize="13"
                    FontWeight="SemiBold"
                    Click="Finish_Click" />
        </StackPanel>
    </Grid>
</Window>
