<Window x:Class="ClipwellWin.Views.KnowledgeBaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipwellWin.Views"
        xmlns:services="clr-namespace:ClipwellWin.Services"
        Title="Ideenkombinat"
        Icon="/Merkautomat;component/Assets/kb-icon-16.png"
        Width="1400" Height="940" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Background="{DynamicResource EditorChromeBrush}"
        Foreground="{DynamicResource OnboardingTextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EditorChrome.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="InstrumentOrange" Color="#FFFF8A24" />

            <Style x:Key="InstrumentCard" TargetType="Border">
                <Setter Property="Margin" Value="5" />
                <Setter Property="Padding" Value="8,8,8,8" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="#FF121110" />
                <Setter Property="BorderBrush" Value="#FF2A2520" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="InstrumentPanel" TargetType="Border">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Padding" Value="14,10,14,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="#FF0F0E0D" />
                <Setter Property="BorderBrush" Value="#FF2A2520" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="InstrumentLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#FFD8D2CA" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="GaugeLabel" TargetType="TextBlock" BasedOn="{StaticResource InstrumentLabel}">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#FFEDEDED" />
            </Style>

            <Style x:Key="PanelSubtitle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,1,0,6" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="#8AEDEDED" />
            </Style>

            <DataTemplate x:Key="TileTemplate">
                <Border Style="{StaticResource InstrumentCard}" ToolTip="{Binding Label}">
                    <StackPanel>
                        <local:SevenSegmentDisplay Value="{Binding Value}" Height="34" Digits="2" />
                        <TextBlock Text="{Binding Label}" Style="{StaticResource InstrumentLabel}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Article lists: Sprachnotizen and Bildschirmaufnahmen -->
            <Style x:Key="KbItemContainerStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="4" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Hit area of the checkbox: a click here toggles the item without clearing the selection -->
                                    <Border x:Name="CheckHit" Background="Transparent" Margin="-8,-6,0,-6" Padding="8,6,0,6"
                                            Cursor="Hand" ToolTip="Zur Auswahl hinzufügen oder entfernen">
                                        <Border x:Name="Check" Width="16" Height="16" CornerRadius="3" Margin="0,1,10,0"
                                                VerticalAlignment="Top" BorderThickness="1"
                                                Background="Transparent" BorderBrush="{DynamicResource EditorBorderBrush}">
                                            <TextBlock x:Name="CheckMark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                       Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="Collapsed" />
                                        </Border>
                                    </Border>
                                    <ContentPresenter Grid.Column="1" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorSelectedBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                                    <Setter TargetName="Check" Property="Background" Value="{DynamicResource OnboardingAccentBrush}" />
                                    <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="KbItemTemplate">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource EditorMutedBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CategoryLabel}" Visibility="{Binding CategoryVisibility}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource OnboardingAccentBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>

            <ContextMenu x:Key="KbItemMenu" x:Shared="False">
                <MenuItem Header="Kategorie festlegen …" InputGestureText="Strg+Umschalt+K" Click="AssignCategory_Click" />
                <MenuItem Header="Mit Vorschlag einordnen …" Click="CategorizeSelection_Click" />
                <Separator />
                <MenuItem Header="Kategorien verwalten …" Click="ManageCategories_Click" />
            </ContextMenu>

            <!-- Aufgaben -->
            <DataTemplate x:Key="TaskItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Done, Mode=OneWay}" Click="TaskDone_Click" VerticalAlignment="Top" Margin="0,2,9,0"
                              ToolTip="Als erledigt markieren" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TaskTitleText" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TaskMetaText" Text="{Binding Meta}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource EditorMutedBrush}" />
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Done}" Value="True">
                        <Setter TargetName="TaskTitleText" Property="TextDecorations" Value="Strikethrough" />
                        <Setter TargetName="TaskTitleText" Property="Foreground" Value="{DynamicResource EditorMutedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Overdue}" Value="True">
                        <Setter TargetName="TaskMetaText" Property="Foreground" Value="#FFE8603B" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Margin" Value="0,12,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource EditorMutedBrush}" />
            </Style>

            <Style x:Key="LibraryScrollBar" TargetType="ScrollBar">
                <Setter Property="Width" Value="14" />
                <Setter Property="Background" Value="{DynamicResource EditorPanelAltBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,2">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinHeight="32" Margin="2,0">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Grip" CornerRadius="4" Background="{DynamicResource EditorMutedBrush}" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource OnboardingAccentBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource OnboardingAccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LibraryScrollViewer" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}" />
                                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                           Style="{StaticResource LibraryScrollBar}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="KbListStyle" TargetType="ListBox">
                <Setter Property="SelectionMode" Value="Extended" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,0,8,4" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" Padding="{TemplateBinding Padding}"
                                          Style="{StaticResource LibraryScrollViewer}"
                                          CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle" Value="{StaticResource KbItemContainerStyle}" />
                <Setter Property="ItemTemplate" Value="{StaticResource KbItemTemplate}" />
            </Style>

            <Style x:Key="ListEmptyStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="22,6,16,6" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource EditorMutedBrush}" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>

            <BitmapImage x:Key="NavigationIcons" UriSource="/Merkautomat;component/Assets/navigation-icons.png" />
            <CroppedBitmap x:Key="DashboardIcon" Source="{StaticResource NavigationIcons}" SourceRect="106,160,459,278" />
            <CroppedBitmap x:Key="OverviewIcon" Source="{StaticResource NavigationIcons}" SourceRect="711,130,405,393" />
            <CroppedBitmap x:Key="SearchIcon" Source="{StaticResource NavigationIcons}" SourceRect="142,719,377,388" />
            <CroppedBitmap x:Key="BrainIcon" Source="{StaticResource NavigationIcons}" SourceRect="688,731,455,368" />
            <Style x:Key="NavigationIconStyle" TargetType="Image">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            </Style>

            <!-- Crop transparent padding so every motif fills the same display area. -->
            <CroppedBitmap x:Key="VoiceLogo" SourceRect="0,0,67,68">
                <CroppedBitmap.Source>
                    <BitmapImage UriSource="/Merkautomat;component/Assets/mic-rec-logo.png" />
                </CroppedBitmap.Source>
            </CroppedBitmap>
            <CroppedBitmap x:Key="RecordingLogo" SourceRect="65,9,1167,1226">
                <CroppedBitmap.Source>
                    <BitmapImage UriSource="/Merkautomat;component/Assets/kb-rec-logo.png" />
                </CroppedBitmap.Source>
            </CroppedBitmap>
            <CroppedBitmap x:Key="ClipboardLogo" SourceRect="85,71,1131,1117">
                <CroppedBitmap.Source>
                    <BitmapImage UriSource="/Merkautomat;component/Assets/cb-logo.png" />
                </CroppedBitmap.Source>
            </CroppedBitmap>

            <Style x:Key="SectionLogoStyle" TargetType="Image">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Stretch" Value="Fill" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            </Style>

            <!-- Tag="active" marks the area whose creation panel is shown. -->
            <Style x:Key="SectionHeaderStyle" TargetType="Button">
                <Setter Property="Margin" Value="8,8,8,4" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="4" Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{DynamicResource EditorPanelAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource EditorBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource EditorHoverBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="active">
                        <Setter Property="Background" Value="{DynamicResource EditorSelectedBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Semantic search -->
            <Style x:Key="SemanticItemContainerStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="4" Padding="10,7">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorSelectedBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="SemanticItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Marked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="SemanticMark_Click" VerticalAlignment="Top" Margin="0,2,9,0" ToolTip="Zum Löschen markieren; Gruppen umfassen alle enthaltenen Einträge" />
                    <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowTitle}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border MaxHeight="36" ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowTitle}" Value="True">
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Snippet}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   LineHeight="18" LineStackingStrategy="BlockLineHeight" ClipToBounds="True"
                                   Foreground="{DynamicResource EditorTextBrush}" ToolTip="{Binding Snippet}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="MaxHeight" Value="36" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTitle}" Value="True">
                                            <Setter Property="MaxHeight" Value="18" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource EditorMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <Style x:Key="ScopeChipStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource EditorBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="10,3">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorSelectedBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToggleChipStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="IsChecked" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource EditorBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="9,3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorSelectedBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="BrainLinkTemplate">
                <Grid ToolTip="{Binding Title}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="{Binding Brush}" />
                    <StackPanel Grid.Column="1">
                        <Border MaxHeight="36" ClipToBounds="True">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding Meta}" ToolTip="{Binding Meta}" FontSize="10.5" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EditorMutedBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <Style x:Key="KbLinkButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource EditorMutedBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="3" Padding="6,2" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorHoverBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource EditorChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="2" VerticalAlignment="Top" Panel.ZIndex="1"
                Background="{DynamicResource AccentStripeBrush}" IsHitTestVisible="False" />

        <!-- Header, same layout as the detail window -->
        <Border x:Name="HeaderActions" Grid.Row="0" Height="50"
                Background="{DynamicResource EditorChromeBrush}"
                BorderBrush="{DynamicResource EditorBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True" Margin="0,0,16,0">
                    <Ellipse x:Name="HeaderStateDot" Width="8" Height="8" Margin="0,0,6,0" Fill="#FF6B6B6B" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderStateLabel" Text="Keine Aufnahme" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource EditorMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="TaskTodayDoneButton" Click="TaskTodayDone_Click" IsEnabled="False" Visibility="Collapsed"
                            Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Heute erledigt" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TaskDeleteButton" Click="TaskDelete_Click" IsEnabled="False" Visibility="Collapsed"
                            Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" ToolTip="Ausgewählte Aufgabe löschen (Entf)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Löschen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyBtn" Content="Kopieren" Click="Copy_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0"
                            ToolTip="Angezeigten Inhalt als Markdown kopieren" />
                    <Button x:Name="MoreButton" Content="Mehr …" Click="MoreMenu_Click" Style="{StaticResource EditorButtonStyle}" ToolTip="Dateien, Aktualisieren und weitere Aktionen">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Importieren …" InputGestureText="Strg+O" Click="Import_Click" />
                                <MenuItem Header="Exportieren …" InputGestureText="Strg+E" Click="Export_Click" />
                                <Separator />
                                <MenuItem Header="Kategorie festlegen …" InputGestureText="Strg+Umschalt+K" Click="AssignCategory_Click"
                                          ToolTip="Hauptkategorie und optional Unterkategorie für die ausgewählten Einträge setzen oder entfernen" />
                                <MenuItem Header="Kategorien verwalten …" Click="ManageCategories_Click"
                                          ToolTip="Haupt- und Unterkategorien anlegen, beschreiben, umbenennen, zusammenführen und löschen" />
                                <MenuItem Header="Auswahl einordnen …" Click="CategorizeSelection_Click"
                                          ToolTip="Kategorie für ausgewählte Einträge, markierte Suchtreffer oder den gewählten Brain-Knoten vorschlagen und zuordnen" />
                                <MenuItem Header="Passende ohne Kategorie finden …" Click="FindCategoryMatches_Click"
                                          ToolTip="Für die im Kategorienfilter gewählte Kategorie die Einträge ohne Kategorie suchen, die am besten dazu passen (ohne Granite)" />
                                <MenuItem x:Name="DiscoveryMenuItem" Header="Kategorien analysieren (Granite) …" Click="CategoryDiscovery_Click"
                                          ToolTip="Einträge ohne Kategorie nach Inhalt gruppieren und von Granite benennen lassen; Vorschläge prüfen und übernehmen" />
                                <MenuItem Header="Einordnung auswerten …" Click="CategorizationReport_Click"
                                          ToolTip="Verfahren auf deinen Zuordnungen vergleichen, Verfahren wählen, Praxiswerte und Verlauf" />
                                <MenuItem Header="Alle ohne Kategorie einordnen …" Click="CategorizeUncategorized_Click"
                                          ToolTip="Alle indizierten Einträge ohne Kategorie nacheinander vorschlagen und bestätigen" />
                                <Separator />
                                <MenuItem Header="Aktualisieren" InputGestureText="F5" Click="Refresh_Click" />
                                <MenuItem Header="Datenordner öffnen" Click="OpenFolder_Click" />
                                <Separator />
                                <MenuItem x:Name="DeleteButton" Header="Ausgewählte Inhalte löschen …" InputGestureText="Entf" Click="Delete_Click" />
                                <MenuItem x:Name="SemanticClearButton" Header="Suchindex zurücksetzen …" Click="SemanticClear_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="400" MinWidth="210" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation and article areas -->
            <Grid x:Name="SidePanel" Grid.Column="0" Background="{DynamicResource EditorPanelBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="12,6,12,0">
                    <RadioButton x:Name="DashboardNav" GroupName="KbNav" Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource DashboardIcon}" Style="{StaticResource NavigationIconStyle}" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="OverviewNav" GroupName="KbNav" Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource OverviewIcon}" Style="{StaticResource NavigationIconStyle}" />
                            <TextBlock Text="Gesamtübersicht" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TasksNav" GroupName="KbNav" Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked"
                                 ToolTip="Aufgaben aus Einträgen und eigene Aufgaben (Strg+T)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons" FontSize="19" Width="22" Margin="0,0,10,0"
                                       TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InstrumentOrange}" />
                            <TextBlock Text="Aufgaben" VerticalAlignment="Center" />
                            <TextBlock x:Name="TasksNavCount" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource EditorMutedBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SemanticNav" GroupName="KbNav" Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked"
                                 ToolTip="Suche nach Bedeutung über Zwischenablage, Sprachnotizen und Bildschirmaufnahmen (Strg+K)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource SearchIcon}" Style="{StaticResource NavigationIconStyle}" />
                            <TextBlock Text="Suche" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="BrainNav" GroupName="KbNav" Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked"
                                 ToolTip="Wissensnetz: Bezüge zwischen allen Einträgen, nach Themen gruppiert (Strg+B)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource BrainIcon}" Style="{StaticResource NavigationIconStyle}" />
                            <TextBlock Text="Brain" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <CheckBox x:Name="BrainLibraryToggle" Content="Bibliothek einblenden" IsChecked="False"
                              Style="{StaticResource ToggleChipStyle}" Margin="0,12,0,8" Visibility="Collapsed"
                              Click="BrainLibrary_Click" ToolTip="Eintragslisten neben dem Wissensnetz anzeigen" />
                </StackPanel>

                <Grid x:Name="LibraryPanel" Grid.Row="1" Background="{DynamicResource EditorPanelBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="NotesRow" Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="RecordingsRow" Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ClipboardRow" Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="CategoryFilterBox" Grid.Row="1" Margin="12,6,12,6" FontSize="12" SelectionChanged="CategoryFilter_SelectionChanged"
                              AutomationProperties.Name="Nach Kategorie filtern" ToolTip="Bibliothek nach Haupt- oder Unterkategorie filtern" />

                    <!-- Area: Sprachnotizen -->
                    <Button x:Name="NotesHeader" Grid.Row="2" Style="{StaticResource SectionHeaderStyle}"
                            Click="NotesHeader_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NotesChevron" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource EditorMutedBrush}" />
                            <Image Grid.Column="1" Source="{StaticResource VoiceLogo}" Style="{StaticResource SectionLogoStyle}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sprechwerk" FontWeight="SemiBold" />
                                <TextBlock x:Name="NotesCount" Margin="8,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource EditorMutedBrush}" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Alle auswählen" Style="{StaticResource KbLinkButton}"
                                    Click="SelectNotes_Click" ToolTip="Alle Sprachnotizen zur Auswahl hinzufügen" />
                        </Grid>
                    </Button>
                    <ListBox x:Name="NotesList" Grid.Row="3" Style="{StaticResource KbListStyle}" ContextMenu="{StaticResource KbItemMenu}"
                             SelectionChanged="ArticleList_SelectionChanged"
                             PreviewMouseLeftButtonDown="ArticleList_PreviewMouseLeftButtonDown"
                             GotKeyboardFocus="ArticleList_GotKeyboardFocus" />
                    <TextBlock x:Name="NotesEmpty" Grid.Row="3" Style="{StaticResource ListEmptyStyle}" />

                    <Border x:Name="NoteComposer" Grid.Row="4" Padding="10,6" Visibility="Collapsed"
                            BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="Neue Sprachnotiz" FontSize="12" Margin="0,0,0,5" />
                            <Grid>
                                <TextBox x:Name="NoteInput" Style="{StaticResource EditorTextBoxStyle}" BorderThickness="1"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="Auto" MinHeight="34" MaxHeight="160"
                                         VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12.5"
                                         TextChanged="NoteInput_TextChanged" PreviewKeyDown="NoteInput_PreviewKeyDown" />
                                <TextBlock x:Name="NoteInputHint" Text="Diktieren oder Text eingeben..." FontSize="12.5"
                                           Margin="11,7,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                           Foreground="{DynamicResource EditorMutedBrush}" />
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="NoteDictateButton" Grid.Column="1" Click="NoteDictate_Click" Style="{StaticResource EditorButtonStyle}"
                                        Width="34" Height="30" MinHeight="30" Padding="5,3" Margin="0,0,6,0" HorizontalContentAlignment="Center"
                                        ToolTip="Diktieren (lokal per Whisper), erneut klicken zum Beenden"
                                        AutomationProperties.Name="Diktieren">
                                    <Grid Width="22" Height="22">
                                        <Image Source="{StaticResource VoiceLogo}" Style="{StaticResource SectionLogoStyle}" />
                                        <Ellipse x:Name="NoteRecordIndicator" Width="11" Height="11" HorizontalAlignment="Left" Margin="-5.5,0,0,0"
                                                 VerticalAlignment="Bottom" Fill="#4CCB75" Stroke="#303030" StrokeThickness="2" />
                                    </Grid>
                                </Button>
                                <TextBlock x:Name="NoteStatus" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EditorMutedBrush}" Margin="8,0" />
                                <Button x:Name="NoteSaveButton" Grid.Column="2" Click="NoteSave_Click" Style="{StaticResource EditorButtonStyle}"
                                        Width="34" Height="30" MinHeight="30" Padding="5,3" HorizontalContentAlignment="Center"
                                        ToolTip="Sprachnotiz speichern (Strg+Enter)" AutomationProperties.Name="Sprachnotiz speichern">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                               Foreground="{DynamicResource OnboardingAccentBrush}" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Area: Bildschirmaufnahmen -->
                    <Button x:Name="RecordingsHeader" Grid.Row="5" Style="{StaticResource SectionHeaderStyle}"
                            Click="RecordingsHeader_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RecordingsChevron" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource EditorMutedBrush}" />
                            <Image Grid.Column="1" Source="{StaticResource RecordingLogo}" Style="{StaticResource SectionLogoStyle}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Bildschirmaufnahmen" FontWeight="SemiBold" />
                                <TextBlock x:Name="RecordingsCount" Margin="8,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource EditorMutedBrush}" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Alle auswählen" Style="{StaticResource KbLinkButton}"
                                    Click="SelectRecordings_Click" ToolTip="Alle Bildschirmaufnahmen zur Auswahl hinzufügen" />
                        </Grid>
                    </Button>
                    <ListBox x:Name="RecordingsList" Grid.Row="6" Style="{StaticResource KbListStyle}" ContextMenu="{StaticResource KbItemMenu}"
                             SelectionChanged="ArticleList_SelectionChanged"
                             PreviewMouseLeftButtonDown="ArticleList_PreviewMouseLeftButtonDown"
                             GotKeyboardFocus="ArticleList_GotKeyboardFocus" />
                    <TextBlock x:Name="RecordingsEmpty" Grid.Row="6" Style="{StaticResource ListEmptyStyle}" />

                    <Border x:Name="RecordingComposer" Grid.Row="7" Padding="12,10,12,10" Visibility="Collapsed"
                            BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="NEUE BILDSCHIRMAUFNAHME" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,6"
                                       Foreground="{DynamicResource EditorMutedBrush}" />
                            <Button x:Name="RecordButton" Click="Record_Click" Style="{StaticResource EditorButtonStyle}"
                                    Width="34" Height="30" MinHeight="30" Padding="5,3"
                                    HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                                    ToolTip="Aufnahme starten">
                                <Grid Width="22" Height="22">
                                    <Image Source="{StaticResource RecordingLogo}" Style="{StaticResource SectionLogoStyle}" />
                                    <Ellipse x:Name="RecordIndicator" Width="11" Height="11" HorizontalAlignment="Left" Margin="-5.5,0,0,0"
                                             VerticalAlignment="Bottom" Fill="#4CCB75" Stroke="#303030" StrokeThickness="2" />
                                </Grid>
                            </Button>
                            <TextBlock x:Name="RecordStatus" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource EditorMutedBrush}"
                                       Text="Liest den sichtbaren Text des aktiven Fensters, keine Bildaufnahme." />
                        </StackPanel>
                    </Border>

                    <!-- Area: Zwischenablage (the whole clipboard history) -->
                    <Button x:Name="ClipboardHeader" Grid.Row="8" Style="{StaticResource SectionHeaderStyle}"
                            Click="ClipboardHeader_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClipboardChevron" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource EditorMutedBrush}" />
                            <Image Grid.Column="1" Source="{StaticResource ClipboardLogo}" Style="{StaticResource SectionLogoStyle}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Zwischenablage" FontWeight="SemiBold" />
                                <TextBlock x:Name="ClipboardCount" Margin="8,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource EditorMutedBrush}" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Alle auswählen" Style="{StaticResource KbLinkButton}"
                                    Click="SelectClipboard_Click" ToolTip="Alle Zwischenablage-Einträge zur Auswahl hinzufügen" />
                        </Grid>
                    </Button>
                    <ListBox x:Name="ClipboardList" Grid.Row="9" Style="{StaticResource KbListStyle}" ContextMenu="{StaticResource KbItemMenu}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="ArticleList_SelectionChanged"
                             PreviewMouseLeftButtonDown="ArticleList_PreviewMouseLeftButtonDown"
                             GotKeyboardFocus="ArticleList_GotKeyboardFocus"
                             MouseDoubleClick="ClipboardList_MouseDoubleClick" />
                    <TextBlock x:Name="ClipboardEmpty" Grid.Row="9" Style="{StaticResource ListEmptyStyle}" />

                    <Border Grid.Row="10" Padding="12,8" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectionLabel" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,8,0"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EditorMutedBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="SelectAll_Click" Style="{StaticResource EditorButtonStyle}" MinHeight="26" Padding="8,3"
                                        FontSize="11.5" Margin="0,0,6,0" ToolTip="Alle Sprachnotizen, Bildschirmaufnahmen und Zwischenablage-Einträge auswählen">
                                    <TextBlock Text="Alle" />
                                </Button>
                                <Button Click="SelectNone_Click" Style="{StaticResource EditorButtonStyle}" MinHeight="26" Padding="8,3"
                                        FontSize="11.5" ToolTip="Auswahl aufheben">
                                    <TextBlock Text="Keine" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource EditorBorderBrush}" />

            <!-- Content -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ContentHeader" Grid.Row="0" Padding="18,10"
                        BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel x:Name="ArticleViewSwitch" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                            <RadioButton x:Name="ArticleMarkdown" GroupName="ArticleViewMode" Content="Markdown" IsChecked="True"
                                         Style="{StaticResource ScopeChipStyle}" Checked="ArticleViewMode_Checked" ToolTip="Markdown formatiert anzeigen" />
                            <RadioButton x:Name="ArticleText" GroupName="ArticleViewMode" Content="Text"
                                         Style="{StaticResource ScopeChipStyle}" Checked="ArticleViewMode_Checked" ToolTip="Unveränderten Markdown-Quelltext anzeigen" />
                        </StackPanel>
                        <StackPanel>
                        <TextBlock x:Name="ContentTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ContentSubtitle" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource EditorMutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                    <ScrollViewer x:Name="DashboardView" Grid.Row="1" Visibility="Collapsed" Background="#FF0A0A0A"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,6,16,12">
                            <UniformGrid Columns="4" Margin="-5,0,-5,0">
                                <Border Style="{StaticResource InstrumentCard}">
                                    <StackPanel>
                                        <local:SevenSegmentDisplay x:Name="ArticleCounter" Height="44" Digits="2" />
                                        <TextBlock Text="Artikel im Ideenkombinat" Style="{StaticResource InstrumentLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InstrumentCard}">
                                    <StackPanel>
                                        <local:SevenSegmentDisplay x:Name="NoteCounter" Height="44" Digits="2" />
                                        <TextBlock Text="Sprachnotizen" Style="{StaticResource InstrumentLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InstrumentCard}">
                                    <StackPanel>
                                        <local:SevenSegmentDisplay x:Name="RecordingCounter" Height="44" Digits="2" />
                                        <TextBlock Text="Bildschirmaufnahmen" Style="{StaticResource InstrumentLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InstrumentCard}">
                                    <StackPanel>
                                        <local:SevenSegmentDisplay x:Name="ClipboardCounter" Height="44" Digits="3" />
                                        <TextBlock Text="Zwischenablage" Style="{StaticResource InstrumentLabel}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource InstrumentPanel}">
                                <StackPanel>
                                    <TextBlock Text="Aktuelle Bildschirmaufnahme" Style="{StaticResource PanelTitle}" />
                                    <TextBlock x:Name="FocusLabel" Text="Noch keine Aufnahme" Style="{StaticResource PanelSubtitle}" />
                                    <UniformGrid Columns="4" Margin="-5,0,-5,0">
                                        <StackPanel Margin="5">
                                            <local:AnalogGauge x:Name="SnapshotGauge" Height="118" />
                                            <TextBlock Text="Erfasst" Style="{StaticResource GaugeLabel}" />
                                        </StackPanel>
                                        <StackPanel Margin="5">
                                            <local:AnalogGauge x:Name="WindowGauge" Height="118" />
                                            <TextBlock Text="Fenster" Style="{StaticResource GaugeLabel}" />
                                        </StackPanel>
                                        <StackPanel Margin="5">
                                            <local:AnalogGauge x:Name="AppGauge" Height="118" />
                                            <TextBlock Text="Anwendungen" Style="{StaticResource GaugeLabel}" />
                                        </StackPanel>
                                        <StackPanel Margin="5">
                                            <local:AnalogGauge x:Name="MinuteGauge" Height="118" />
                                            <TextBlock Text="Minuten" Style="{StaticResource GaugeLabel}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InstrumentPanel}">
                                <StackPanel>
                                    <TextBlock Text="Statistik der Bibliothek" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="Erfasste Inhalte nach Anwendung" Style="{StaticResource PanelSubtitle}" />
                                    <ItemsControl x:Name="AppTiles" Margin="-5,0,-5,0" ItemTemplate="{StaticResource TileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock x:Name="AppTilesEmpty" Text="Noch keine Bildschirmaufnahmen erfasst."
                                               Style="{StaticResource PanelSubtitle}" Margin="0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InstrumentPanel}">
                                <StackPanel>
                                    <TextBlock Text="Zwischenablage" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="Kopierte Inhalte nach Webseite" Style="{StaticResource PanelSubtitle}" />
                                    <ItemsControl x:Name="DomainTiles" Margin="-5,0,-5,0" ItemTemplate="{StaticResource TileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock x:Name="DomainTilesEmpty" Text="Noch keine Webseiten in der History."
                                               Style="{StaticResource PanelSubtitle}" Margin="0" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                <Grid x:Name="SemanticView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,10,18,8" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="SemanticQuery" Style="{StaticResource EditorTextBoxStyle}" BorderThickness="1"
                                             Padding="28,7,8,7" FontSize="13" TextChanged="SemanticQuery_TextChanged"
                                             PreviewKeyDown="SemanticQuery_PreviewKeyDown" />
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="10,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource EditorMutedBrush}" />
                                    <TextBlock x:Name="SemanticQueryHint" FontSize="13" Margin="31,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                               Text="Frage oder Stichworte, z. B. wie habe ich das VPN-Zertifikat erneuert"
                                               Foreground="{DynamicResource EditorMutedBrush}" />
                                </Grid>
                                <Button x:Name="SemanticSearchButton" Grid.Column="1" Click="SemanticSearch_Click"
                                        Style="{StaticResource EditorButtonStyle}" Margin="10,0,0,0" ToolTip="Suchen (Enter)">
                                    <TextBlock Text="Suchen" />
                                </Button>
                                <Button x:Name="SemanticAskButton" Grid.Column="2" Click="SemanticAsk_Click"
                                        Style="{StaticResource EditorButtonStyle}" Margin="10,0,0,0"
                                        ToolTip="Frage mit Granite aus den besten Treffern beantworten, mit Quellenangaben (Strg+Enter). Läuft lokal.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Fragen" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SemanticDuplicatesButton" Grid.Column="3" Click="SemanticDuplicates_Click"
                                        Style="{StaticResource EditorButtonStyle}" Margin="10,0,0,0"
                                        ToolTip="Dublettenfilter ein- oder ausschalten">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Dubletten" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ScopeAll" GroupName="SemanticScope" Content="Alle Quellen" IsChecked="True"
                                                 Style="{StaticResource ScopeChipStyle}" Checked="SemanticScope_Checked" />
                                    <RadioButton x:Name="ScopeClipboard" GroupName="SemanticScope" Content="Zwischenablage"
                                                 Style="{StaticResource ScopeChipStyle}" Checked="SemanticScope_Checked" />
                                    <RadioButton x:Name="ScopeNotes" GroupName="SemanticScope" Content="Sprachnotizen"
                                                 Style="{StaticResource ScopeChipStyle}" Checked="SemanticScope_Checked" />
                                    <RadioButton x:Name="ScopeRecordings" GroupName="SemanticScope" Content="Bildschirmaufnahmen"
                                                 Style="{StaticResource ScopeChipStyle}" Checked="SemanticScope_Checked" />
                                </StackPanel>

                            </Grid>
                            <Expander x:Name="SemanticDuplicatePanel" Header="Dublettenfilter" IsExpanded="False" Margin="0,10,0,0" Visibility="Collapsed">
                                <WrapPanel Margin="0,8,0,0">
                                <ComboBox x:Name="SemanticDuplicateView" SelectedIndex="0" MinWidth="170" Margin="0,0,8,6"
                                          SelectionChanged="SemanticDuplicateOptions_Changed" ToolTip="Ergebnisansicht des Dublettenfilters">
                                    <ComboBoxItem Content="Dubletten-Gruppen" />
                                    <ComboBoxItem Content="Alle Dubletten einzeln" />
                                    <ComboBoxItem Content="Je Gruppe ein Eintrag" />
                                </ComboBox>
                                <ComboBox x:Name="SemanticDuplicateKind" SelectedIndex="0" MinWidth="150" Margin="0,0,10,6"
                                          SelectionChanged="SemanticDuplicateOptions_Changed" ToolTip="Aehnlichkeit oder gleicher Text; Leerraum wird beim Textvergleich vereinheitlicht">
                                    <ComboBoxItem Content="Ähnlicher Inhalt" />
                                    <ComboBoxItem Content="Gleicher Text" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,6" VerticalAlignment="Center">
                                    <TextBlock Text="Ähnlichkeit ab" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider x:Name="SemanticDuplicateThreshold" Width="110" Minimum="0.90" Maximum="1" Value="0.97"
                                            TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01"
                                            ValueChanged="SemanticDuplicateThreshold_Changed" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SemanticDuplicateThresholdLabel" Text="97 %" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Filter beenden" Click="SemanticDuplicateExit_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,0,6" />
                            </WrapPanel>
                            </Expander>
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="SemanticMarkToggle" Content="Alle markieren" Click="SemanticMarkToggle_Click" Style="{StaticResource KbLinkButton}" Margin="0,0,12,0" />
                                <TextBlock x:Name="SemanticMarkedLabel" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource EditorMutedBrush}" Visibility="Collapsed" />
                                <Button x:Name="SemanticSimilarMarked" Content="Ähnliche zu Markierten" Click="SemanticSimilarMarked_Click" IsEnabled="False" Visibility="Collapsed"
                                        Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0"
                                        ToolTip="Rocchio-Rückmeldung: sucht Einträge, die den markierten inhaltlich ähneln, zusammen mit dem Suchtext. Weitere passende markieren und erneut klicken, um das Ergebnis zu schärfen." />
                                <Button x:Name="SemanticCategorizeMarked" Content="Markierte einordnen …" Click="SemanticCategorizeMarked_Click" IsEnabled="False" Visibility="Collapsed"
                                        Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" ToolTip="Kategorie mit dem Modell aus der Kontrollstation vorschlagen und zuordnen" />
                                <Button x:Name="SemanticDeleteMarked" Content="Markierte löschen" Click="SemanticDeleteMarked_Click" IsEnabled="False" Visibility="Collapsed"
                                        Style="{StaticResource EditorButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SemanticModelPanel" Grid.Row="1" Padding="18,12" Visibility="Collapsed"
                            Background="{DynamicResource EditorPanelAltBrush}"
                            BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SemanticModelText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            <Button x:Name="SemanticDownloadButton" Grid.Column="1" Click="SemanticDownload_Click"
                                    Style="{StaticResource EditorButtonStyle}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Modell laden" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="SemanticAnswerPanel" Grid.Row="2" Padding="18,10,18,10" Visibility="Collapsed"
                            Background="{DynamicResource EditorPanelAltBrush}"
                            BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="SemanticAnswerCopy" Content="Kopieren" Click="SemanticAnswerCopy_Click" Style="{StaticResource KbLinkButton}"
                                            Margin="12,0,0,0" ToolTip="Antwort mit Quellenliste kopieren" />
                                    <Button x:Name="SemanticAnswerCancel" Content="Abbrechen" Click="SemanticAnswerCancel_Click" Style="{StaticResource KbLinkButton}"
                                            Margin="12,0,0,0" />
                                    <Button x:Name="SemanticAnswerClose" Content="Ausblenden" Click="SemanticAnswerClose_Click" Style="{StaticResource KbLinkButton}"
                                            Margin="12,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="SemanticAnswerHeader" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource InstrumentOrange}" />
                            </DockPanel>
                            <TextBox x:Name="SemanticAnswerText" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                     Foreground="{DynamicResource OnboardingTextPrimaryBrush}" FontSize="13"
                                     MaxHeight="220" VerticalScrollBarVisibility="Auto" />
                            <ItemsControl x:Name="SemanticAnswerSources" Grid.Row="2" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="SemanticAnswerSource_Click" Style="{StaticResource EditorButtonStyle}" MinHeight="24"
                                                Padding="8,2" FontSize="11.5" Margin="0,4,6,0" MaxWidth="320" ToolTip="{Binding Tooltip}">
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.25*" MinWidth="220" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="SemanticResults" Grid.Column="0" SelectionMode="Single"
                                 Style="{StaticResource KbListStyle}" Background="Transparent" BorderThickness="0" Padding="8,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource SemanticItemContainerStyle}"
                                 ItemTemplate="{StaticResource SemanticItemTemplate}"
                                 SelectionChanged="SemanticResults_SelectionChanged"
                                 MouseDoubleClick="SemanticResults_MouseDoubleClick" />
                        <TextBlock x:Name="SemanticEmpty" Grid.Column="0" Style="{StaticResource ListEmptyStyle}" Margin="22,14,16,6" />

                        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource EditorBorderBrush}" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Padding="14,8" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SemanticPreviewTitle" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EditorMutedBrush}"
                                               Text="Kein Treffer ausgewählt" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="SemanticSimilarButton" Click="SemanticSimilar_Click" IsEnabled="False"
                                                Style="{StaticResource EditorButtonStyle}" Margin="10,0,0,0"
                                                ToolTip="Inhaltlich ähnliche Einträge zu diesem Treffer suchen">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Ähnliche" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SemanticOpenButton" Click="SemanticOpen_Click" IsEnabled="False"
                                                Style="{StaticResource EditorButtonStyle}" Margin="10,0,0,0"
                                                ToolTip="Treffer öffnen: Detailfenster bzw. Artikel im Ideenkombinat (Doppelklick)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Öffnen" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBox x:Name="SemanticPreview" Grid.Row="1"
                                     Style="{StaticResource EditorTextBoxStyle}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="18,12" />
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="BrainView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,10,18,8" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="BrainQuery" Style="{StaticResource EditorTextBoxStyle}" BorderThickness="1"
                                             Padding="28,6,8,6" FontSize="12.5" TextChanged="BrainQuery_TextChanged"
                                             PreviewKeyDown="BrainQuery_PreviewKeyDown" />
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="10,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource EditorMutedBrush}" />
                                    <TextBlock x:Name="BrainQueryHint" FontSize="12.5" Margin="31,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                               Text="Im Netz suchen (Strg+F)"
                                               Foreground="{DynamicResource EditorMutedBrush}" />
                                </Grid>
                                <Button Grid.Column="1" Content="Nach Bedeutung" Click="BrainMeaning_Click"
                                        Style="{StaticResource EditorButtonStyle}" Margin="8,0,0,0" ToolTip="Bedeutung statt Wortlaut suchen (Enter)" />
                                <Button Grid.Column="2" Content="Zurücksetzen" Click="BrainClearSearch_Click"
                                        Style="{StaticResource EditorButtonStyle}" Margin="8,0,0,0" ToolTip="Suchtext und Hervorhebung zurücksetzen" />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="Gruppieren nach" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,4" Foreground="{DynamicResource EditorMutedBrush}" />
                                <RadioButton x:Name="BrainGroupTopics" GroupName="BrainGrouping" Content="Themen" IsChecked="True" Style="{StaticResource ScopeChipStyle}"
                                             Checked="BrainGrouping_Checked" Margin="0,0,0,4" ToolTip="Automatische Themen aus inhaltlichen Bezügen" />
                                <RadioButton x:Name="BrainGroupCategories" GroupName="BrainGrouping" Content="Kategorien" Style="{StaticResource ScopeChipStyle}"
                                             Checked="BrainGrouping_Checked" Margin="0,0,16,4" ToolTip="Deine gespeicherten Haupt- und Unterkategorien; Farben je Hauptkategorie, Einträge ohne Kategorie grau" />
                                <Button Content="Netz einpassen" Click="BrainFit_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,6,4" ToolTip="Ganzes Netz anzeigen (Pos1)" />
                                <Button Content="Neu anordnen" Click="BrainRelayout_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,16,4" ToolTip="Positionen der Knoten neu berechnen" />
                                <Button x:Name="BrainRelationsButton" IsEnabled="False" Content="Weg finden …" Click="BrainRelations_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,6,4" />
                                <Button x:Name="BrainEditRelationsButton" IsEnabled="{Binding IsEnabled, ElementName=BrainRelationsButton}" Content="Beziehungen …" Click="BrainEditRelations_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,6,4" />
                                <Button x:Name="DiscoveryButton" Content="Kategorien analysieren …" Click="CategoryDiscovery_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,6,4"
                                        ToolTip="Granite gruppiert Einträge ohne Kategorie und schlägt Kategorienamen vor (dauert einige Minuten)" />
                                <Button Content="Ohne Kategorie einordnen …" Click="CategorizeUncategorized_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,6,4"
                                        ToolTip="Alle Einträge ohne Kategorie nacheinander mit dem Modell aus der Kontrollstation einordnen" />
                            </WrapPanel>
                            <Expander x:Name="BrainFilters" Header="Filter: Quellen, Verbindungen und Ähnlichkeit" Margin="0,8,0,0" FontSize="12" IsExpanded="False">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Quellen" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource EditorMutedBrush}"/>
                                    <WrapPanel Grid.Column="1" Margin="0,2">
                                <CheckBox x:Name="BrainSrcClipboard" Content="Zwischenablage" Style="{StaticResource ToggleChipStyle}"
                                          Click="BrainSource_Click" ToolTip="Kreise" />
                                <CheckBox x:Name="BrainSrcNotes" Content="Sprechwerk" Style="{StaticResource ToggleChipStyle}"
                                          Click="BrainSource_Click" ToolTip="Rauten" />
                                <CheckBox x:Name="BrainSrcRecordings" Content="Bildschirmaufnahmen" Style="{StaticResource ToggleChipStyle}"
                                          Click="BrainSource_Click" ToolTip="Quadrate" />

                                    </WrapPanel>
                                    <TextBlock Grid.Row="1" Text="Verbindungen" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource EditorMutedBrush}"/>
                                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                                <CheckBox x:Name="BrainEdgeSemantic" Content="Inhaltlich" Style="{StaticResource ToggleChipStyle}"
                                          Tag="#FFB0B0B0" Click="BrainEdge_Click" ToolTip="Ähnliche Bedeutung (Farbe des Themas)" />
                                <CheckBox x:Name="BrainEdgeTime" Content="Zeitlich" Style="{StaticResource ToggleChipStyle}"
                                          Tag="#FF64B5F6" Click="BrainEdge_Click" ToolTip="Kurz nacheinander entstanden" />
                                <CheckBox x:Name="BrainEdgeSession" Content="Gleiche Aufnahme" Style="{StaticResource ToggleChipStyle}"
                                          Tag="#FFE0E0E0" Click="BrainEdge_Click" ToolTip="Aufeinanderfolgende Bildwechsel einer Bildschirmaufnahme" />
                                <CheckBox x:Name="BrainEdgeDomain" Content="Gleiche Webseite" Style="{StaticResource ToggleChipStyle}"
                                          Tag="#FF81C784" Click="BrainEdge_Click" ToolTip="Gleiche Domain in URL oder Quelle" />
                                <CheckBox x:Name="BrainEdgeManual" Content="Manuell" Style="{StaticResource ToggleChipStyle}"
                                          Tag="#FFCE93D8" Click="BrainEdge_Click" ToolTip="Selbst gepflegte, gerichtete Beziehungen" />
                                <CheckBox x:Name="BrainEdgeSummary" Content="Zusammenfassung" Style="{StaticResource ToggleChipStyle}"
                                          Tag="#FFFFB74D" Click="BrainEdge_Click" ToolTip="Gespeicherte Zusammenfassung mit ihren Ausgangseinträgen" />
                                <CheckBox x:Name="BrainEdgeCategory" Content="Gleiche Kategorie" Style="{StaticResource ToggleChipStyle}"
                                          Tag="#FF4DD0E1" Click="BrainEdge_Click" ToolTip="Nur bei Gruppieren nach Kategorien: Einträge mit gleicher Haupt- bzw. Unterkategorie (zieht sie im Netz zusammen)" />

                                    </WrapPanel>
                                    <TextBlock Grid.Row="2" Text="Ähnlichkeit ab" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource EditorMutedBrush}"/>
                                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,6,0,2">
                                <Slider x:Name="BrainThreshold" Width="110" Minimum="0.80" Maximum="0.95" Value="0.86"
                                        SmallChange="0.01" LargeChange="0.02" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" ValueChanged="BrainThreshold_ValueChanged"
                                        ToolTip="Ab welcher inhaltlichen Ähnlichkeit zwei Einträge verknüpft werden" />
                                <TextBlock x:Name="BrainThresholdLabel" Text="86 %" FontSize="11" Margin="6,0,10,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource EditorMutedBrush}" />
                                <CheckBox x:Name="BrainFocus" Content="Umgebung hervorheben" IsChecked="False" Style="{StaticResource ToggleChipStyle}"
                                          Click="BrainFocus_Click" ToolTip="Nur die Umgebung (zwei Schritte) des gewählten Eintrags hervorheben" />

                                    </WrapPanel>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="330" MinWidth="280" MaxWidth="520" />
                        </Grid.ColumnDefinitions>

                        <local:BrainCanvas x:Name="BrainCanvasView" Grid.Column="0" ClipToBounds="True" FocusVisualStyle="{x:Null}" />
                        <TextBlock x:Name="BrainEmpty" Grid.Column="0" Margin="24" FontSize="12.5" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource EditorMutedBrush}" Visibility="Collapsed" />

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource EditorBorderBrush}" />

                        <Grid Grid.Column="2" Background="{DynamicResource EditorPanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="BrainDetailRow" Height="0" MaxHeight="330" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="BrainDetail" Margin="14,12,14,6" Visibility="Collapsed">
                                <Button x:Name="BrainBackButton" Content="Zurück zu Themen" Click="BrainOverview_Click" Style="{StaticResource KbLinkButton}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <TextBlock x:Name="BrainDetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="BrainDetailMeta" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource EditorMutedBrush}" />
                                <TextBox x:Name="BrainDetailText" Style="{StaticResource EditorTextBoxStyle}" Margin="0,6,0,0"
                                         IsReadOnly="True" TextWrapping="Wrap" MinLines="1" MaxLines="6" FontSize="11.5" Padding="8,6"
                                         SizeChanged="BrainPreview_SizeChanged" VerticalScrollBarVisibility="Disabled" BorderThickness="1" />
                                <Button x:Name="BrainPreviewMore" Content="Mehr anzeigen" Click="BrainPreviewMore_Click"
                                        Style="{StaticResource KbLinkButton}" HorizontalAlignment="Left" Margin="0,5,0,0" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Click="BrainOpen_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0"
                                            ToolTip="Als Artikel im Ideenkombinat öffnen (Doppelklick auf den Knoten)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Öffnen" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BrainSimilar_Click" Style="{StaticResource EditorButtonStyle}"
                                            ToolTip="In der semantischen Suche ähnliche Einträge zeigen">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Ähnliche" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            </ScrollViewer>
                            <TextBlock x:Name="BrainLinksHeader" Grid.Row="1" Margin="14,10,14,4" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource EditorMutedBrush}" Text="THEMEN" />
                            <ListBox x:Name="BrainList" Grid.Row="2" Style="{StaticResource KbListStyle}" Padding="4,0,4,6" SelectionMode="Single"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource SemanticItemContainerStyle}"
                                     ItemTemplate="{StaticResource BrainLinkTemplate}"
                                     SelectionChanged="BrainList_SelectionChanged" />


                            <Border Grid.Row="4" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,1,0,0" Padding="12">
                                <StackPanel>
                                    <TextBlock x:Name="BrainActionHint" Text="Ein Thema oder einen Eintrag auswählen." FontSize="11" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource EditorMutedBrush}" Margin="0,0,0,8" />
                                    <Button x:Name="BrainCategorizeButton" IsEnabled="{Binding IsEnabled, ElementName=BrainManageButton}" Content="Mit lokaler KI einordnen …" Click="BrainCategorize_Click"
                                            Style="{StaticResource EditorButtonStyle}" Margin="0,0,0,6" Padding="6,8" FontSize="12" HorizontalAlignment="Stretch"
                                            ToolTip="Eintrag mit seinen Verbindungen bzw. das Thema gemeinsam und einzeln einordnen (Modell aus der Kontrollstation)" />
                                    <UniformGrid Columns="2">
                                        <Button x:Name="BrainManageButton" IsEnabled="False" Content="Thema bearbeiten …" Click="BrainKnowledge_Click"
                                                Style="{StaticResource EditorButtonStyle}" Margin="0,0,6,0" Padding="6,8" FontSize="12" ToolTip="Name und Kategorie für ausgewählte Quellen festlegen" />
                                        <Button x:Name="BrainSummarizeButton" IsEnabled="{Binding IsEnabled, ElementName=BrainManageButton}" Content="Zusammenfassen …" Click="BrainSummarize_Click"
                                                Style="{StaticResource EditorButtonStyle}" Padding="6,8" FontSize="12" ToolTip="Quellen zu einer bearbeitbaren Sprachnotiz zusammenfassen" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="TasksView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,10,18,8" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="NewTaskInput" Style="{StaticResource EditorTextBoxStyle}" BorderThickness="1"
                                             Padding="28,7,8,7" FontSize="13" MaxLength="{x:Static services:TaskStore.MaxTitle}"
                                             TextChanged="NewTaskInput_TextChanged" PreviewKeyDown="NewTaskInput_PreviewKeyDown" />
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="10,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource EditorMutedBrush}" />
                                    <TextBlock x:Name="NewTaskHint" FontSize="13" Margin="31,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                               Text="Neue Aufgabe, mit Enter hinzufügen"
                                               Foreground="{DynamicResource EditorMutedBrush}" />
                                </Grid>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <RadioButton x:Name="TaskFilterOpen" GroupName="TaskFilter" Content="Offen" IsChecked="True"
                                             Style="{StaticResource ScopeChipStyle}" Checked="TaskFilter_Checked" />
                                <RadioButton x:Name="TaskFilterDone" GroupName="TaskFilter" Content="Erledigt"
                                             Style="{StaticResource ScopeChipStyle}" Checked="TaskFilter_Checked" />
                                <RadioButton x:Name="TaskFilterAll" GroupName="TaskFilter" Content="Alle"
                                             Style="{StaticResource ScopeChipStyle}" Checked="TaskFilter_Checked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.25*" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="14,10,14,8" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel HorizontalAlignment="Left">
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Click="TaskCalendarPrev_Click" Style="{StaticResource EditorButtonStyle}" MinHeight="24" Padding="7,2"
                                                    ToolTip="Vorheriger Monat">
                                                <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                                            </Button>
                                            <Button Click="TaskCalendarToday_Click" Style="{StaticResource EditorButtonStyle}" MinHeight="24" Padding="8,2"
                                                    FontSize="11.5" Margin="4,0" ToolTip="Zum aktuellen Monat und die Aufgaben von heute zeigen">
                                                <TextBlock Text="Heute" />
                                            </Button>
                                            <Button Click="TaskCalendarNext_Click" Style="{StaticResource EditorButtonStyle}" MinHeight="24" Padding="7,2"
                                                    ToolTip="Nächster Monat">
                                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="TaskCalendarTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DockPanel>
                                    <Grid x:Name="TaskCalendarGrid" />
                                </StackPanel>
                            </Border>

                            <DockPanel x:Name="TaskDateFilterBar" Grid.Row="1" Margin="16,8,16,0" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Content="Filter aufheben" Click="TaskDateFilterClear_Click"
                                        Style="{StaticResource KbLinkButton}" Margin="10,0,0,0" />
                                <TextBlock x:Name="TaskDateFilterLabel" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource InstrumentOrange}" />
                            </DockPanel>

                            <ListBox x:Name="TasksList" Grid.Row="2" SelectionMode="Single"
                                     Style="{StaticResource KbListStyle}" Background="Transparent" BorderThickness="0" Padding="8,6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource SemanticItemContainerStyle}"
                                     ItemTemplate="{StaticResource TaskItemTemplate}"
                                     SelectionChanged="TasksList_SelectionChanged" />
                            <TextBlock x:Name="TasksEmpty" Grid.Row="2" Style="{StaticResource ListEmptyStyle}" Margin="22,14,16,6" />
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource EditorBorderBrush}" />

                        <Grid x:Name="TaskDetail" Grid.Column="2">
                            <!-- Notes and source share the remaining height; the splitter between them sets the split. -->
                            <Grid x:Name="TaskEditor" Margin="18,4,18,14" IsEnabled="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="TaskNotesRow" Height="*" MinHeight="60" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="TaskSourceRow" Height="3*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Titel" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TaskTitleBox" Style="{StaticResource EditorTextBoxStyle}" BorderThickness="1" Padding="8,6"
                                             FontSize="13" MaxLength="{x:Static services:TaskStore.MaxTitle}" TextChanged="TaskField_Changed" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Fällig am" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                            <TextBox x:Name="TaskDueBox" Style="{StaticResource EditorTextBoxStyle}" BorderThickness="1" Padding="8,6"
                                                     FontSize="13" MaxLength="10" TextChanged="TaskField_Changed"
                                                     PreviewKeyDown="TaskDueBox_PreviewKeyDown" PreviewMouseLeftButtonUp="TaskDueBox_PreviewMouseLeftButtonUp"
                                                     ToolTip="Klicken öffnet den Kalender; Datum auch eintippbar (TT.MM.JJJJ oder TT.MM., leer für kein Datum)" />
                                            <Popup x:Name="TaskDuePopup" PlacementTarget="{Binding ElementName=TaskDueBox}" Placement="Bottom"
                                                   VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                <Border Background="{DynamicResource EditorPanelBrush}" BorderBrush="{DynamicResource EditorBorderBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,8">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="Black" />
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Click="TaskDuePickerPrev_Click" Style="{StaticResource EditorButtonStyle}" MinHeight="24" Padding="7,2"
                                                                        Margin="0,0,4,0" ToolTip="Vorheriger Monat">
                                                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                                                                </Button>
                                                                <Button Click="TaskDuePickerNext_Click" Style="{StaticResource EditorButtonStyle}" MinHeight="24" Padding="7,2"
                                                                        ToolTip="Nächster Monat">
                                                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                                                                </Button>
                                                            </StackPanel>
                                                            <TextBlock x:Name="TaskDuePickerTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       Margin="0,0,12,0" Foreground="{DynamicResource OnboardingTextPrimaryBrush}" />
                                                        </DockPanel>
                                                        <Grid x:Name="TaskDuePickerGrid" />
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Button Content="Heute" Tag="0" Click="TaskDueQuick_Click" Style="{StaticResource EditorButtonStyle}"
                                                                    MinHeight="24" Padding="8,2" FontSize="11.5" Margin="0,0,4,0" />
                                                            <Button Content="Morgen" Tag="1" Click="TaskDueQuick_Click" Style="{StaticResource EditorButtonStyle}"
                                                                    MinHeight="24" Padding="8,2" FontSize="11.5" Margin="0,0,4,0" />
                                                            <Button Content="Nächster Montag" Tag="monday" Click="TaskDueQuick_Click" Style="{StaticResource EditorButtonStyle}"
                                                                    MinHeight="24" Padding="8,2" FontSize="11.5" Margin="0,0,4,0" />
                                                            <Button Content="Kein Datum" Tag="none" Click="TaskDueQuick_Click" Style="{StaticResource EditorButtonStyle}"
                                                                    MinHeight="24" Padding="8,2" FontSize="11.5" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="TaskDueError" FontSize="11" Foreground="#FFE8603B" Margin="0,0,0,4"
                                                       Text="Datum als TT.MM.JJJJ eingeben." Visibility="Collapsed" />
                                            <CheckBox x:Name="TaskDoneBox" Content="Erledigt" Click="TaskDoneBox_Click" Margin="0,0,0,7" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Notizen" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TaskNotesBox" Grid.Row="2" Style="{StaticResource EditorTextBoxStyle}" BorderThickness="1" Padding="8,6"
                                         FontSize="12.5" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" MaxLength="{x:Static services:TaskStore.MaxNotes}" TextChanged="TaskField_Changed" />
                                <Border x:Name="TaskSplitterLine" Grid.Row="3" Height="1" Margin="0,5" Visibility="Collapsed"
                                        Background="{DynamicResource EditorBorderBrush}" IsHitTestVisible="False" />
                                <GridSplitter x:Name="TaskSplitter" Grid.Row="3" Height="11" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS"
                                              ToolTip="Ziehen: Platz zwischen Notizen und Quelle verteilen" />
                                <Grid x:Name="TaskSourcePanel" Grid.Row="4" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TaskSourceLabel" Style="{StaticResource FieldLabel}" Margin="0,2,0,4" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <RichTextBox x:Name="TaskSourceText" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True" IsReadOnlyCaretVisible="False"
                                                 BorderThickness="1" BorderBrush="{DynamicResource EditorBorderBrush}" Padding="6,6" MinHeight="80"
                                                 Background="{DynamicResource EditorTextBodyBrush}" Foreground="{DynamicResource EditorTextBrush}"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                 FontSize="12.5" />
                                </Grid>
                                <TextBlock x:Name="TaskCreatedLabel" Grid.Row="5" FontSize="11" Margin="0,10,0,0" Foreground="{DynamicResource EditorMutedBrush}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <TextBox x:Name="MarkdownView" Grid.Row="1"
                         Style="{StaticResource EditorTextBoxStyle}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="18,12" />
                <RichTextBox x:Name="FormattedMarkdownView" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True"
                             BorderThickness="0" Background="{DynamicResource EditorTextBodyBrush}" Foreground="{DynamicResource EditorTextBrush}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="18,6" Visibility="Collapsed"
                Background="{DynamicResource EditorChromeBrush}"
                BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" FontSize="11" Foreground="{DynamicResource EditorMutedBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
