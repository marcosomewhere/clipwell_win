<Window x:Class="ClipwellWin.Views.KnowledgeBaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipwellWin.Views"
        Title="Clipwell KB"
        Width="980" Height="680" MinWidth="640" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>
        <SolidColorBrush x:Key="InstrumentOrange" Color="#FFFF8A24" />

        <Style x:Key="InstrumentCard" TargetType="Border">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10,12,10,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#FF121110" />
            <Setter Property="BorderBrush" Value="#FF2A2520" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="InstrumentPanel" TargetType="Border">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Padding" Value="16,14,16,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#FF0F0E0D" />
            <Setter Property="BorderBrush" Value="#FF2A2520" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="InstrumentLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFD8D2CA" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="GaugeLabel" TargetType="TextBlock" BasedOn="{StaticResource InstrumentLabel}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFEDEDED" />
        </Style>

        <Style x:Key="PanelSubtitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,10" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8AEDEDED" />
        </Style>

        <DataTemplate x:Key="TileTemplate">
            <Border Style="{StaticResource InstrumentCard}" ToolTip="{Binding Label}">
                <StackPanel>
                    <local:SevenSegmentDisplay Value="{Binding Value}" Height="46" Digits="2" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource InstrumentLabel}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="KbButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PopupTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                                Background="{DynamicResource PopupBackgroundBrush}"
                                BorderBrush="{DynamicResource PopupPanelBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{DynamicResource PopupBackgroundBrush}"
            BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="2" VerticalAlignment="Top" Margin="10,0,10,0"
                    Background="{DynamicResource AccentStripeBrush}"
                    IsHitTestVisible="False" Panel.ZIndex="1" />

            <!-- Kopfzeile -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    Background="{DynamicResource PopupPanelBrush}" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="3"
                                Padding="6,0,6,1" VerticalAlignment="Center">
                            <TextBlock Text="KB" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RecordButton" Style="{StaticResource KbButton}" Click="Record_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RecordIcon" Text="&#xE7C8;" FontFamily="Segoe Fluent Icons"
                                           FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="RecordLabel" Text="Aufnahme starten" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Aktualisieren" Style="{StaticResource KbButton}" Click="Refresh_Click" />
                        <Button Content="Kopieren" Style="{StaticResource KbButton}" Click="Copy_Click" />
                        <Button Content="Exportieren..." Style="{StaticResource KbButton}" Click="Export_Click" />
                        <Button Content="Ordner öffnen" Style="{StaticResource KbButton}" Click="OpenFolder_Click" />
                        <Button x:Name="DeleteButton" Content="Löschen" Style="{StaticResource KbButton}" Click="Delete_Click" />
                    </StackPanel>
                    <Button Grid.Column="2" ToolTip="Schließen"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource PopupTextMutedBrush}" FontSize="13" Padding="6,2"
                            Click="Close_Click" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="SessionList" Grid.Column="0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SessionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6,2,6,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PopupSelectedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PopupTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource PopupTextSubtleBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource PopupPanelBorderBrush}" />

                <ScrollViewer x:Name="DashboardView" Grid.Column="2" Visibility="Collapsed" Background="#FF0A0A0A"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,14,18,18">
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource InstrumentOrange}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="StateDot" Width="8" Height="8" Margin="0,0,6,0" Fill="#FF6B6B6B" />
                                <TextBlock x:Name="StateLabel" Text="INAKTIV" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PopupTextSubtleBrush}" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="4" Margin="-5,0,-5,0">
                            <Border Style="{StaticResource InstrumentCard}">
                                <StackPanel>
                                    <local:SevenSegmentDisplay x:Name="ArticleCounter" Height="56" Digits="2" />
                                    <TextBlock Text="Artikel in der KB" Style="{StaticResource InstrumentLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InstrumentCard}">
                                <StackPanel>
                                    <local:SevenSegmentDisplay x:Name="NoteCounter" Height="56" Digits="2" />
                                    <TextBlock Text="Notizen" Style="{StaticResource InstrumentLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InstrumentCard}">
                                <StackPanel>
                                    <local:SevenSegmentDisplay x:Name="RecordingCounter" Height="56" Digits="2" />
                                    <TextBlock Text="Aufnahmen" Style="{StaticResource InstrumentLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InstrumentCard}">
                                <StackPanel>
                                    <local:SevenSegmentDisplay x:Name="ClipboardCounter" Height="56" Digits="3" />
                                    <TextBlock Text="Zwischenablage" Style="{StaticResource InstrumentLabel}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource InstrumentPanel}">
                            <StackPanel>
                                <TextBlock Text="Aktuelle Aufnahme" Style="{StaticResource PanelTitle}" />
                                <TextBlock x:Name="FocusLabel" Text="Noch keine Aufnahme" Style="{StaticResource PanelSubtitle}" />
                                <UniformGrid Columns="4" Margin="-5,0,-5,0">
                                    <Grid Margin="5">
                                        <local:AnalogGauge x:Name="SnapshotGauge" Height="150" />
                                        <TextBlock Text="Erfasst" Style="{StaticResource GaugeLabel}" />
                                    </Grid>
                                    <Grid Margin="5">
                                        <local:AnalogGauge x:Name="WindowGauge" Height="150" />
                                        <TextBlock Text="Fenster" Style="{StaticResource GaugeLabel}" />
                                    </Grid>
                                    <Grid Margin="5">
                                        <local:AnalogGauge x:Name="AppGauge" Height="150" />
                                        <TextBlock Text="Anwendungen" Style="{StaticResource GaugeLabel}" />
                                    </Grid>
                                    <Grid Margin="5">
                                        <local:AnalogGauge x:Name="MinuteGauge" Height="150" />
                                        <TextBlock Text="Minuten" Style="{StaticResource GaugeLabel}" />
                                    </Grid>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InstrumentPanel}">
                            <StackPanel>
                                <TextBlock Text="Statistik der Bibliothek" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text="Erfasste Inhalte nach Anwendung" Style="{StaticResource PanelSubtitle}" />
                                <ItemsControl x:Name="AppTiles" Margin="-5,0,-5,0" ItemTemplate="{StaticResource TileTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="AppTilesEmpty" Text="Noch keine Aufnahmen erfasst."
                                           Style="{StaticResource PanelSubtitle}" Margin="0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InstrumentPanel}">
                            <StackPanel>
                                <TextBlock Text="Zwischenablage" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text="Kopierte Inhalte nach Webseite" Style="{StaticResource PanelSubtitle}" />
                                <ItemsControl x:Name="DomainTiles" Margin="-5,0,-5,0" ItemTemplate="{StaticResource TileTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="DomainTilesEmpty" Text="Noch keine Webseiten in der History."
                                           Style="{StaticResource PanelSubtitle}" Margin="0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InstrumentPanel}">
                            <StackPanel>
                                <TextBlock Text="Gespeicherte Artikel" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text="Exportierte Notizen und Aufnahmen, zum Öffnen anklicken" Style="{StaticResource PanelSubtitle}" />
                                <ItemsControl x:Name="ArticleList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Click="Article_Click" Cursor="Hand" Margin="0,0,0,6">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="#FF15120F" BorderBrush="#FF2E2820"
                                                                BorderThickness="1" CornerRadius="5" Padding="12,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border BorderBrush="{StaticResource InstrumentOrange}" BorderThickness="1"
                                                                        CornerRadius="3" Padding="6,1" Margin="0,0,12,0"
                                                                        VerticalAlignment="Center" MinWidth="78">
                                                                    <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{StaticResource InstrumentOrange}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                               Foreground="#FFEDEDED" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,2,0,0"
                                                                               Foreground="#8AEDEDED" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InstrumentOrange}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ArticleListEmpty"
                                           Text="Noch keine Artikel. Notizen über &quot;In KB exportieren&quot; übernehmen oder eine Aufnahme starten."
                                           Style="{StaticResource PanelSubtitle}" TextWrapping="Wrap" Margin="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBox x:Name="MarkdownView" Grid.Column="2"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="12,10"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource PopupTextPrimaryBrush}" />
            </Grid>

            <Border Grid.Row="2" Padding="10,6"
                    BorderBrush="{DynamicResource PopupPanelBorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusLabel" FontSize="11"
                           Foreground="{DynamicResource PopupTextSubtleBrush}" />
            </Border>
        </Grid>
    </Border>
</Window>
