<Window x:Class="ClipwellWin.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Clipwell – Details"
        Width="740" Height="580"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Kopfzeile ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleLabel" FontSize="18" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ReasonLabel" Margin="0,4,0,0"
                       Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ── Hauptinhalt ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <!-- Bildvorschau (mit Zoom/Pan-Container) -->
            <Border x:Name="ImageBorder" Visibility="Collapsed"
                    Background="#10000000" ClipToBounds="True">
                <ScrollViewer x:Name="ImageScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="Both">
                    <Image x:Name="ImagePreview" Stretch="Uniform"
                           RenderTransformOrigin="0.5,0.5"
                           MouseWheel="ImagePreview_MouseWheel">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                </ScrollViewer>
            </Border>

            <!-- Bilddetails (unter dem Bild) -->
            <StackPanel x:Name="ImageDetailsPanel" Visibility="Collapsed"
                        VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="ImageSizeLabel"   Opacity="0.7" FontSize="12" Margin="0,0,16,0" />
                <TextBlock x:Name="ImageFormatLabel" Opacity="0.7" FontSize="12" Margin="0,0,16,0" />
                <TextBlock x:Name="OcrStatusLabel"   Opacity="0.7" FontSize="12" />
            </StackPanel>

            <!-- Code-Ansicht mit Syntax-Highlighting + Zeilennummern -->
            <FlowDocumentScrollViewer x:Name="CodeViewer" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto" />

            <!-- Farb-Eintrag Detailansicht -->
            <ScrollViewer x:Name="ColorPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8,0,0">
                    <!-- Großer Farbswatch -->
                    <Border x:Name="ColorSwatch" Height="120" CornerRadius="8" Margin="0,0,0,16" />
                    <!-- Werte-Grid -->
                    <Grid x:Name="ColorValuesGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Text-Ansicht -->
            <TextBox x:Name="TextPreview" IsReadOnly="True"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <!-- ── Werkzeugleiste ──────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,6,0,0"
                BorderBrush="#22000000" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <!-- Zeilenumbruch-Toggle (nur für Text/Code) -->
                <ToggleButton x:Name="WrapToggle"
                              Content="Umbruch"
                              IsChecked="True"
                              Padding="10,4" FontSize="12"
                              Checked="WrapToggle_Changed"
                              Unchecked="WrapToggle_Changed"
                              Margin="0,0,8,0" />

                <!-- OCR-Text anzeigen (nur für Bilder mit OCR) -->
                <Button x:Name="ShowOcrBtn"
                        Content="OCR-Text anzeigen"
                        Padding="10,4" FontSize="12"
                        Visibility="Collapsed"
                        Click="ShowOcr_Click"
                        Margin="0,0,8,0" />

                <!-- Zoom-Reset (nur für Bilder) -->
                <Button x:Name="ZoomResetBtn"
                        Content="Zoom zurücksetzen"
                        Padding="10,4" FontSize="12"
                        Visibility="Collapsed"
                        Click="ZoomReset_Click"
                        Margin="0,0,8,0" />
                <TextBlock x:Name="ZoomLabel"
                           VerticalAlignment="Center"
                           FontSize="12" Opacity="0.6"
                           Visibility="Collapsed" />

                <!-- Lazy-Load Rest (nur für lange Code-Dateien) -->
                <Button x:Name="LoadMoreBtn"
                        Padding="10,4" FontSize="12"
                        Visibility="Collapsed"
                        Click="LoadMore_Click"
                        Margin="0,0,8,0" />
            </StackPanel>
        </Border>

        <!-- ── Fußzeile ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Kopieren" MinWidth="96" Margin="0,0,8,0"
                    Click="Copy_Click" />
            <Button Content="Schließen" MinWidth="96"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
