<Window x:Class="ClipwellWin.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipwell - Details"
        Width="1260" Height="820"
        MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized"
        Background="{DynamicResource OnboardingBackgroundBrush}"
        Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="EditorChromeBrush" Color="#101418" />
        <SolidColorBrush x:Key="EditorPanelBrush" Color="#171D22" />
        <SolidColorBrush x:Key="EditorPanelAltBrush" Color="#1F262D" />
        <SolidColorBrush x:Key="EditorCanvasBackBrush" Color="#232A31" />
        <SolidColorBrush x:Key="EditorBorderBrush" Color="#303943" />
        <SolidColorBrush x:Key="EditorMutedBrush" Color="#9AA6B2" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
        </Style>

        <Style x:Key="EditorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource EditorPanelAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28313A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#323C45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryEditorButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource OnboardingAccentBrush}" />
            <Setter Property="Foreground" Value="#111418" />
            <Setter Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
        </Style>

        <Style x:Key="EditorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource EditorPanelAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28313A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OnboardingAccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                                <Setter Property="Foreground" Value="#111418" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{DynamicResource OnboardingTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource EditorPanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28313A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OnboardingAccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                                <Setter Property="Foreground" Value="#111418" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer"
                                BorderBrush="{StaticResource EditorBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="2">
                            <Ellipse Fill="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" />
                                <Setter TargetName="Outer" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource EditorChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource EditorChromeBrush}"
                BorderBrush="{StaticResource EditorBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="14"
                               Foreground="{DynamicResource OnboardingAccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="TitleLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleSeparator" Text="|" Foreground="{StaticResource EditorMutedBrush}" Margin="14,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    <StackPanel x:Name="ImageDetailsPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ImageFormatLabel" Foreground="{StaticResource EditorMutedBrush}" FontSize="12" Margin="0,0,12,0" />
                        <TextBlock x:Name="ImageSizeLabel" Foreground="{StaticResource EditorMutedBrush}" FontSize="12" Margin="0,0,12,0" />
                        <TextBlock x:Name="OcrStatusLabel" Foreground="{StaticResource EditorMutedBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="ReasonLabel" Foreground="{StaticResource EditorMutedBrush}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel x:Name="ZoomControlsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button Content="-" Width="34" Padding="0" Style="{StaticResource EditorButtonStyle}"
                            Click="EditorZoomOut_Click" />
                    <Border Width="56" Height="32"
                            Background="{StaticResource EditorPanelBrush}"
                            BorderBrush="{StaticResource EditorBorderBrush}"
                            BorderThickness="0,1"
                            Margin="-1,0">
                        <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Border>
                    <Button Content="+" Width="34" Padding="0" Style="{StaticResource EditorButtonStyle}"
                            Click="EditorZoomIn_Click" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CopyBtn" Click="Copy_Click" Style="{StaticResource PrimaryEditorButtonStyle}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Kopieren" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveAsBtn" Click="SaveAs_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Speichern unter" />
                        </StackPanel>
                    </Button>
                    <Button Click="Close_Click" Style="{StaticResource EditorButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Schließen" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border x:Name="ImageBorder"
                    Visibility="Collapsed"
                    Background="{StaticResource EditorPanelBrush}"
                    BorderBrush="{StaticResource EditorBorderBrush}"
                    BorderThickness="0,0,0,1"
                    ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ImageEditorToolbar"
                            Grid.Column="0"
                            Background="{StaticResource EditorPanelBrush}"
                            BorderBrush="{StaticResource EditorBorderBrush}"
                            BorderThickness="0,0,1,0"
                            Padding="10,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="MARKIEREN" FontSize="10" Foreground="{StaticResource EditorMutedBrush}" Margin="0,0,0,7" />
                                <RadioButton Tag="Select" GroupName="EditorTool" Checked="EditorTool_Click" IsChecked="True" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B0;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="20" />
                                        <TextBlock Text="Auswahl" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Arrow" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="->" FontSize="13" Width="20" />
                                        <TextBlock Text="Pfeil" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Rectangle" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="□" FontSize="13" Width="20" />
                                        <TextBlock Text="Rahmen" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Text" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="T" FontSize="13" Width="20" />
                                        <TextBlock Text="Text" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Number" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="1" FontSize="13" Width="20" />
                                        <TextBlock Text="Marker" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Line" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="/" FontSize="13" Width="20" />
                                        <TextBlock Text="Linie" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Ellipse" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="○" FontSize="13" Width="20" />
                                        <TextBlock Text="Ellipse" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Pen" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="20" />
                                        <TextBlock Text="Stift" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Highlight" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▰" FontSize="12" Width="20" />
                                        <TextBlock Text="Highlight" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>

                                <TextBlock Text="SCHÜTZEN" FontSize="10" Foreground="{StaticResource EditorMutedBrush}" Margin="0,9,0,7" />
                                <RadioButton Tag="Redact" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="■" FontSize="12" Width="20" />
                                        <TextBlock Text="Schwärzen" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Pixelate" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▦" FontSize="12" Width="20" />
                                        <TextBlock Text="Pixelate" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <Border x:Name="PixelateOptions"
                                        Visibility="Collapsed"
                                        Background="{StaticResource EditorPanelAltBrush}"
                                        BorderBrush="{StaticResource EditorBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,-1,0,4">
                                    <StackPanel>
                                        <TextBlock Text="Pixeldichte" FontSize="10" Foreground="{StaticResource EditorMutedBrush}" Margin="0,0,0,4" />
                                        <Slider x:Name="PixelateSlider"
                                                Minimum="4" Maximum="28" Value="10"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="PixelateSlider_ValueChanged" />
                                        <TextBlock x:Name="PixelateValueLabel"
                                                   Text="10 px"
                                                   FontSize="10"
                                                   Foreground="{StaticResource EditorMutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <RadioButton Tag="Blur" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◫" FontSize="12" Width="20" />
                                        <TextBlock Text="Blur" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>

                                <TextBlock Text="BILD" FontSize="10" Foreground="{StaticResource EditorMutedBrush}" Margin="0,9,0,7" />
                                <RadioButton Tag="Crop" GroupName="EditorTool" Checked="EditorTool_Click" Style="{StaticResource ToolRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7A8;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="20" />
                                        <TextBlock Text="Crop" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="STIL" FontSize="10" Foreground="{StaticResource EditorMutedBrush}" Margin="0,0,0,7" />
                                <WrapPanel x:Name="EditorColorSwatches" Margin="0,0,0,11">
                                    <RadioButton GroupName="EditorColor" Tag="#E53935" Background="#E53935" ToolTip="Rot"
                                                 Checked="EditorColorSwatch_Checked" IsChecked="True" Style="{StaticResource SwatchStyle}" />
                                    <RadioButton GroupName="EditorColor" Tag="#FDD835" Background="#FDD835" ToolTip="Gelb"
                                                 Checked="EditorColorSwatch_Checked" Style="{StaticResource SwatchStyle}" />
                                    <RadioButton GroupName="EditorColor" Tag="#43A047" Background="#43A047" ToolTip="Grün"
                                                 Checked="EditorColorSwatch_Checked" Style="{StaticResource SwatchStyle}" />
                                    <RadioButton GroupName="EditorColor" Tag="#1E88E5" Background="#1E88E5" ToolTip="Blau"
                                                 Checked="EditorColorSwatch_Checked" Style="{StaticResource SwatchStyle}" />
                                    <RadioButton GroupName="EditorColor" Tag="#FFFFFF" Background="#FFFFFF" ToolTip="Weiß"
                                                 Checked="EditorColorSwatch_Checked" Style="{StaticResource SwatchStyle}" />
                                    <RadioButton GroupName="EditorColor" Tag="#111111" Background="#111111" ToolTip="Schwarz"
                                                 Checked="EditorColorSwatch_Checked" Style="{StaticResource SwatchStyle}" />
                                </WrapPanel>
                                <Slider x:Name="StrokeSlider"
                                        Minimum="2" Maximum="16" Value="4"
                                        ValueChanged="StrokeSlider_ValueChanged"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True" />
                                <TextBlock x:Name="StrokeValueLabel"
                                           Text="4 px"
                                           FontSize="10"
                                           Foreground="{StaticResource EditorMutedBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="TEXTGRÖSSE" FontSize="10" Foreground="{StaticResource EditorMutedBrush}" Margin="0,9,0,4" />
                                <Slider x:Name="TextSizeSlider"
                                        Minimum="10" Maximum="48" Value="18"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="TextSizeSlider_ValueChanged" />
                                <TextBlock x:Name="TextSizeValueLabel"
                                           Text="18 px"
                                           FontSize="10"
                                           Foreground="{StaticResource EditorMutedBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource EditorCanvasBackBrush}"
                            Padding="18">
                        <ScrollViewer x:Name="ImageScrollViewer"
                                      Background="{StaticResource EditorCanvasBackBrush}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PanningMode="Both">
                            <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                  MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                <Canvas x:Name="EditorCanvas"
                                        Background="#FFEFEFEF"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MouseLeftButtonDown="EditorCanvas_MouseLeftButtonDown"
                                        MouseMove="EditorCanvas_MouseMove"
                                        MouseLeftButtonUp="EditorCanvas_MouseLeftButtonUp"
                                        MouseWheel="ImagePreview_MouseWheel">
                                    <Canvas.LayoutTransform>
                                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                                    </Canvas.LayoutTransform>
                                    <Image x:Name="ImagePreview" Stretch="Fill" />
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ColorPanel"
                          Visibility="Collapsed"
                          Margin="18"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8,0,0">
                    <Border x:Name="ColorSwatch" Height="120" CornerRadius="8" Margin="0,0,0,16" />
                    <Grid x:Name="ColorValuesGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="TextEditorPanel"
                    Visibility="Collapsed"
                    Margin="18"
                    Background="#101820"
                    BorderBrush="{StaticResource EditorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="TextEditorHeader"
                          Grid.Row="0"
                          Background="#141C24"
                          Margin="0"
                          VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                       Foreground="{DynamicResource OnboardingAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock x:Name="TextEditorTitleLabel"
                                       Text="Text aus Zwischenablage"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Ellipse x:Name="TextDirtyDot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource OnboardingAccentBrush}"
                                     Visibility="Collapsed"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <ComboBox x:Name="EditorLanguageBox"
                                      Width="150"
                                      Visibility="Collapsed"
                                      SelectionChanged="EditorLanguageBox_SelectionChanged"
                                      Margin="0,0,8,0" />
                            <ToggleButton x:Name="EditorWrapToggle"
                                          Content="Umbruch"
                                          IsChecked="True"
                                          Checked="EditorWrapToggle_Changed"
                                          Unchecked="EditorWrapToggle_Changed"
                                          Style="{StaticResource EditorToggleStyle}"
                                          Margin="0,0,8,0" />
                            <Button x:Name="UndoTextBtn"
                                    Visibility="Collapsed"
                                    IsEnabled="False"
                                    Click="UndoText_Click"
                                    Style="{StaticResource EditorButtonStyle}"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Rückgängig" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SaveTextBtn"
                                    Visibility="Collapsed"
                                    IsEnabled="False"
                                    Click="SaveText_Click"
                                    Style="{StaticResource PrimaryEditorButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Speichern" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="TextEditorBody"
                          Grid.Row="1"
                          Background="#0B1117"
                          ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LineNumberPanel"
                                Grid.Column="0"
                                Background="#0E151C"
                                BorderBrush="{StaticResource EditorBorderBrush}"
                                BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="LineNumberScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False"
                                          IsHitTestVisible="False">
                                <TextBlock x:Name="LineNumberText"
                                           Text="1"
                                           FontFamily="Cascadia Code, Consolas"
                                           FontSize="14"
                                           LineHeight="24"
                                           TextAlignment="Right"
                                           VerticalAlignment="Top"
                                           Padding="0,17,14,0"
                                           Foreground="#87919C" />
                            </ScrollViewer>
                        </Border>
                        <TextBox x:Name="TextPreview"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="#0B1117"
                                 Foreground="#F4F6F8"
                                 CaretBrush="{DynamicResource OnboardingAccentBrush}"
                                 FontFamily="Cascadia Code, Consolas"
                                 FontSize="15"
                                 Padding="20,16,20,56"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 TextChanged="TextPreview_TextChanged"
                                 KeyDown="TextPreview_KeyDown"
                                 SizeChanged="TextPreview_SizeChanged"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                        <Border Grid.Column="1"
                                IsHitTestVisible="False"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="CodeHighlightScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False"
                                          IsHitTestVisible="False">
                                <TextBlock x:Name="CodeHighlightOverlay"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           FontFamily="Cascadia Code, Consolas"
                                           FontSize="15"
                                           Padding="20,16,20,56"
                                           TextWrapping="Wrap"
                                           Foreground="#F4F6F8" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid x:Name="TextEditorFooter"
                          Grid.Row="2"
                          Background="#141C24"
                          Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock x:Name="TextLineCountLabel"
                                       Text="Zeilen: 1"
                                       Foreground="{StaticResource EditorMutedBrush}"
                                       Margin="0,0,22,0" />
                            <TextBlock Text="|"
                                       Foreground="{StaticResource EditorBorderBrush}"
                                       Margin="0,0,22,0" />
                            <TextBlock x:Name="TextCharCountLabel"
                                       Text="Zeichen: 0"
                                       Foreground="{StaticResource EditorMutedBrush}"
                                       Margin="0,0,22,0" />
                            <TextBlock Text="|"
                                       Foreground="{StaticResource EditorBorderBrush}"
                                       Margin="0,0,22,0" />
                            <TextBlock x:Name="TextModeLabel"
                                       Text="Nur-Text"
                                       Foreground="{StaticResource EditorMutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Name="TextStatusLabel"
                                       Text="Bereit"
                                       Foreground="{StaticResource EditorMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource OnboardingAccentBrush}"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="BottomActionBar"
                Grid.Row="2"
                Background="{StaticResource EditorChromeBrush}"
                BorderBrush="{StaticResource EditorBorderBrush}"
                BorderThickness="0,1,0,0"
                MinHeight="64"
                Padding="18,10">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ShowOcrBtn"
                            Content="OCR-Text anzeigen"
                            Visibility="Collapsed"
                            Click="ShowOcr_Click"
                            Style="{StaticResource EditorButtonStyle}"
                            Margin="0,0,8,0" />
                    <StackPanel x:Name="EditorActionsPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                    <Button Click="EditorUndo_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Rückgängig" />
                        </StackPanel>
                    </Button>
                    <Button Click="EditorRedo_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A6;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Wiederholen" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DuplicateBtn" Click="EditorDuplicate_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Duplizieren" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteBtn" Click="EditorDelete_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Löschen" />
                        </StackPanel>
                    </Button>
                    <Button Click="EditorExpandCanvas_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Rand" />
                        </StackPanel>
                    </Button>
                    <Button Click="EditorAutoTrim_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A8;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Auto-Trim" />
                        </StackPanel>
                    </Button>
                    <Button Click="EditorResize_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Skalieren" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ZoomResetBtn"
                            Visibility="Collapsed"
                            Click="ZoomReset_Click"
                            Style="{StaticResource EditorButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="1:1" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Zoom zurücksetzen" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
