<Window x:Class="ClipwellWin.Views.RecoveryKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Merkautomat;component/Assets/kb-icon-16.png"
        Title="Notschlüssel" SizeToContent="Height" Width="560" ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource EditorChromeBrush}" Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Height="3" VerticalAlignment="Top" Background="{DynamicResource OnboardingAccentBrush}" />
        <StackPanel Margin="22,24,22,18">
            <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"
                       Foreground="{DynamicResource EditorTextBrush}" />
            <TextBlock x:Name="Explanation" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"
                       Foreground="{DynamicResource EditorTextBrush}" />
            <TextBox x:Name="KeyBox" FontFamily="Cascadia Mono, Consolas" FontSize="18" Padding="10,8"
                     HorizontalContentAlignment="Center" Style="{DynamicResource EditorTextBoxStyle}"
                     AutomationProperties.Name="Notschlüssel" />
            <TextBlock x:Name="ErrorText" Foreground="#E5534B" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            <CheckBox x:Name="ConfirmBox" Margin="0,14,0,0" Foreground="{DynamicResource EditorTextBrush}"
                      Content="Ich habe den Notschlüssel sicher aufbewahrt (Passwortmanager oder Papier)."
                      Checked="ConfirmBox_Changed" Unchecked="ConfirmBox_Changed" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource EditorPanelBrush}" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button x:Name="CopyButton" DockPanel.Dock="Left" Content="Kopieren" MinWidth="92" Style="{DynamicResource EditorButtonStyle}" Click="Copy_Click" />
                <Button x:Name="OkButton" DockPanel.Dock="Right" MinWidth="92" Margin="8,0,0,0" IsDefault="True" Style="{DynamicResource BrainPrimaryButton}" Click="Ok_Click" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Abbrechen" MinWidth="92" IsCancel="True" Style="{DynamicResource EditorButtonStyle}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
