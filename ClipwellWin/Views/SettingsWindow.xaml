<ui:FluentWindow x:Class="ClipwellWin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Clipwell – Einstellungen"
        Width="600" Height="700"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Einstellungen"
                     ShowMinimize="False" ShowMaximize="False" />

        <TabControl Grid.Row="1" Margin="16,8,16,16"
                    Background="Transparent" BorderThickness="0">

            <!-- ═══════════════════════════════ Allgemein ══════════════════ -->
            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Globaler Hotkey" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HotkeyStatusLabel" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Tastenkombination aufnehmen:" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox x:Name="HotkeyRecorderBox" IsReadOnly="True"
                                                Width="180" Margin="0,0,8,0"
                                                PreviewKeyDown="HotkeyRecorderBox_PreviewKeyDown" />
                                    <ui:Button Content="Übernehmen" Click="ApplyHotkey_Click"
                                               Appearance="Primary" />
                                </StackPanel>

                                <TextBlock Text="Oder manuell setzen:" Margin="0,12,0,6" />
                                <WrapPanel>
                                    <ui:ToggleSwitch x:Name="ModWin"   Margin="0,0,8,4" OffContent="Win"   OnContent="Win"   IsChecked="True" />
                                    <ui:ToggleSwitch x:Name="ModShift" Margin="0,0,8,4" OffContent="Shift" OnContent="Shift" IsChecked="True" />
                                    <ui:ToggleSwitch x:Name="ModCtrl"  Margin="0,0,8,4" OffContent="Ctrl"  OnContent="Ctrl" />
                                    <ui:ToggleSwitch x:Name="ModAlt"   Margin="0,0,0,4"  OffContent="Alt"   OnContent="Alt" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="+ Taste:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:TextBox x:Name="HotkeyChar" MaxLength="1" Width="50" Text="V"
                                                HorizontalContentAlignment="Center" Margin="0,0,8,0" />
                                    <ui:Button Content="Manuell übernehmen" Click="ApplyManualHotkey_Click" />
                                </StackPanel>

                                <TextBlock Text="Aktion beim Hotkey:" Margin="0,14,0,6" />
                                <ComboBox x:Name="HotkeyActionBox" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Nur Menü öffnen" />
                                    <ComboBoxItem Content="Neuesten Eintrag sofort einfügen" />
                                </ComboBox>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Erkennung" FontWeight="SemiBold" />
                                    <TextBlock Text="Code-Erkennung und Inhaltsdetails" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="Code-Erkennung:" Margin="0,0,0,6" />
                                <ComboBox x:Name="CodeModeBox" Width="180" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Konservativ" />
                                    <ComboBoxItem Content="Normal" />
                                    <ComboBoxItem Content="Aggressiv" />
                                </ComboBox>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="History-Limit" FontWeight="SemiBold" />
                                    <TextBlock Text="Maximale Anzahl gespeicherter Einträge" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:NumberBox x:Name="MaxItemsBox" Value="500"
                                              Minimum="50" Maximum="5000"
                                              Width="100" Margin="0,0,8,0" />
                                <ui:Button Content="Speichern" Click="SaveGeneral_Click" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Überwachung pausieren" FontWeight="SemiBold" />
                                    <TextBlock Text="Clipboard-Änderungen werden nicht gespeichert" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="PauseSwitch" Click="PauseSwitch_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Popup-Position merken" FontWeight="SemiBold" />
                                    <TextBlock Text="Fenster-Grösse und -Position beim nächsten Öffnen wiederherstellen" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="RememberPositionSwitch" Click="RememberPosition_Click" />
                        </ui:CardControl>

                        <ui:CardControl>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Paste-Testmodus" FontWeight="SemiBold" />
                                    <TextBlock Text="Fokus-Restore, Ctrl+V und Win+V in einem Testfeld prüfen" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel>
                                <TextBox x:Name="PasteTestBox" MinHeight="80"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Ctrl+V testen" Click="TestCtrlV_Click" Margin="0,0,8,0" />
                                    <ui:Button Content="Win+V testen"  Click="TestWinV_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ui:CardControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Darstellung ═══════════════ -->
            <TabItem Header="Darstellung">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Farbschema" FontWeight="SemiBold" />
                                    <TextBlock Text="Welches Theme soll Clipwell verwenden?" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="ThemeBox" Width="150" Margin="0,0,8,0"
                                          SelectionChanged="ThemeBox_SelectionChanged">
                                    <ComboBoxItem Content="System" />
                                    <ComboBoxItem Content="Dunkel" />
                                    <ComboBoxItem Content="Hell" />
                                    <ComboBoxItem Content="Kompakt (Hell)" />
                                </ComboBox>
                            </StackPanel>
                        </ui:CardControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Privatsphäre ══════════════ -->
            <TabItem Header="Privatsphäre">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Inkognito-Modus" FontWeight="SemiBold" />
                                    <TextBlock Text="Nichts speichern – alle Clipboard-Änderungen ignorieren" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="IncognitoSwitch" Click="IncognitoSwitch_Click" />
                        </ui:CardControl>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Apps ausschliessen" FontWeight="SemiBold" />
                                    <TextBlock Text="Prozessnamen kommagetrennt – Clipboard wird für diese Apps nicht gespeichert" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <ui:TextBox x:Name="IncognitoAppsBox"
                                            PlaceholderText="z.B. KeePass, 1Password, bitwarden"
                                            AcceptsReturn="False" TextWrapping="Wrap"
                                            Margin="0,0,0,8" />
                                <ui:Button Content="Speichern" Click="SaveIncognitoApps_Click" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Domains ausschliessen" FontWeight="SemiBold" />
                                    <TextBlock Text="URLs dieser Domains werden nicht gespeichert (kommagetrennt)" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <ui:TextBox x:Name="IncognitoDomainsBox"
                                            PlaceholderText="z.B. bank.de, paypal.com"
                                            AcceptsReturn="False" TextWrapping="Wrap"
                                            Margin="0,0,0,8" />
                                <ui:Button Content="Speichern" Click="SaveIncognitoDomains_Click" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Sensible Inhalte filtern" FontWeight="SemiBold" />
                                    <TextBlock Text="API-Keys, Tokens, Passwörter und Private Keys automatisch nicht speichern" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="FilterSensitiveSwitch" Click="FilterSensitive_Click" />
                        </ui:CardControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Daten ════════════════════ -->
            <TabItem Header="Daten">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Speicherlimits" FontWeight="SemiBold" />
                                    <TextBlock Text="Ältere oder zu viele Einträge automatisch löschen" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Maximales Alter (Tage, 0 = deaktiviert):" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ui:NumberBox x:Name="MaxAgeBox" Value="0" Minimum="0" Maximum="3650"
                                                  Width="100" Margin="0,0,8,0" />
                                </StackPanel>
                                <TextBlock Text="Maximale DB-Grösse in MB (0 = deaktiviert):" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ui:NumberBox x:Name="MaxSizeBox" Value="0" Minimum="0" Maximum="10240"
                                                  Width="100" Margin="0,0,8,0" />
                                </StackPanel>
                                <ui:Button Content="Speichern" Click="SaveStorageLimits_Click" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Export" FontWeight="SemiBold" />
                                    <TextBlock Text="History als JSON oder SQLite-Backup speichern" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Als JSON exportieren" Click="ExportJson_Click" Margin="0,0,8,0" />
                                    <ui:Button Content="Als SQLite-Backup exportieren" Click="ExportSqlite_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Import" FontWeight="SemiBold" />
                                    <TextBlock Text="History aus JSON-Datei importieren" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <ui:Button Content="Aus JSON importieren" Click="ImportJson_Click" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False" x:Name="AutoBackupExpander">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Automatisches Backup" FontWeight="SemiBold" />
                                    <TextBlock Text="Täglich einen JSON-Export automatisch erstellen" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <ui:CardControl Margin="0,0,0,10">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Auto-Backup aktivieren" FontWeight="SemiBold" />
                                            <TextBlock Text="Einmal täglich beim Start einen JSON-Export anlegen" FontSize="12" Opacity="0.6" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="AutoBackupSwitch" Click="AutoBackupSwitch_Click" />
                                </ui:CardControl>
                                <TextBlock Text="Backup-Verzeichnis:" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:TextBox x:Name="AutoBackupDirBox" IsReadOnly="True" Width="260"
                                                PlaceholderText="Noch kein Verzeichnis gewählt"
                                                Margin="0,0,8,0" />
                                    <ui:Button Content="Durchsuchen…" Click="AutoBackupBrowse_Click" />
                                </StackPanel>
                                <TextBlock x:Name="AutoBackupStatusLabel" FontSize="12" Opacity="0.65" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Zurücksetzen" FontWeight="SemiBold" />
                                    <TextBlock Text="Einzelne Bereiche sicher löschen (mit Bestätigung)" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <WrapPanel>
                                    <ui:Button Content="History löschen" Appearance="Caution"
                                               Click="ResetHistory_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="URL-Cache löschen" Appearance="Caution"
                                               Click="ResetUrlCache_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="Einstellungen zurücksetzen" Appearance="Caution"
                                               Click="ResetSettings_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:CardExpander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Tastaturhilfe ════════════ -->
            <TabItem Header="Tastaturhilfe">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Popup" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                        <TextBlock LineHeight="22" TextWrapping="Wrap">
Enter: Eintrag einfügen&#x0a;Ctrl+Enter: Plain Text einfügen&#x0a;Pfeil hoch/runter: Auswahl bewegen&#x0a;Ctrl+P: Eintrag pinnen&#x0a;Entf: Eintrag löschen&#x0a;Esc: Popup schließen</TextBlock>
                        <Separator Margin="0,16,0,16" />
                        <TextBlock Text="Erweiterte Suche" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                        <TextBlock LineHeight="22" TextWrapping="Wrap">
type:url  – nur URLs anzeigen&#x0a;kind:json  – nur JSON-Einträge&#x0a;domain:github.com  – URLs einer Domain&#x0a;pinned:true / pinned:false  – nach Pin-Status filtern</TextBlock>
                        <Separator Margin="0,16,0,16" />
                        <TextBlock Text="Kontextmenü" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                        <TextBlock LineHeight="22" TextWrapping="Wrap">
Rechtsklick auf einen Eintrag: Kopieren, Plain Copy, Pinnen, Löschen, URL neu laden, Detailansicht und manuelle Typkorrektur.</TextBlock>
                        <Separator Margin="0,16,0,16" />
                        <TextBlock Text="Hotkey" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                        <TextBlock LineHeight="22" TextWrapping="Wrap">
Der globale Hotkey kann das Menü öffnen oder den neuesten Eintrag direkt einfügen. Wenn Windows die Kombination blockiert, zeigt Clipwell den Fehlercode an.</TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Tastenkürzel ══════════════ -->
            <TabItem Header="Tastenkürzel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Popup-Aktionen konfigurieren" FontWeight="SemiBold"
                                   FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12">
Die folgenden Tastenkombinationen gelten für das Popup-Fenster. Enter, Esc und Pfeiltasten sind fest belegt.</TextBlock>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Eintrag pinnen" FontWeight="SemiBold" />
                                    <TextBlock Text="Standard: Ctrl+P" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch x:Name="PinCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                 IsChecked="True" Margin="0,0,8,0" />
                                <ui:TextBox x:Name="PinKeyBox" MaxLength="1" Width="50"
                                            HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Details öffnen" FontWeight="SemiBold" />
                                    <TextBlock Text="Standard: F2" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox x:Name="DetailsKeyBox" Width="80"
                                        PlaceholderText="F2" HorizontalContentAlignment="Center" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Schnellnotiz" FontWeight="SemiBold" />
                                    <TextBlock Text="Standard: Ctrl+N" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch x:Name="QuickNoteCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                 IsChecked="True" Margin="0,0,8,0" />
                                <ui:TextBox x:Name="QuickNoteKeyBox" MaxLength="1" Width="50"
                                            HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Pinboard öffnen/schließen" FontWeight="SemiBold" />
                                    <TextBlock Text="Standard: Ctrl+B" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch x:Name="PinboardCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                 IsChecked="True" Margin="0,0,8,0" />
                                <ui:TextBox x:Name="PinboardKeyBox" MaxLength="1" Width="50"
                                            HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:Button Content="Tastenkürzel speichern" Appearance="Primary"
                                   Click="SaveShortcuts_Click" Margin="0,8,0,0" />
                        <ui:Button Content="Auf Standard zurücksetzen"
                                   Click="ResetShortcuts_Click" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Über ═════════════════════ -->
            <TabItem Header="Über">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                    <TextBlock Text="Clipwell für Windows" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock x:Name="VersionLabel" FontSize="13" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Separator Margin="0,0,0,12" />
                    <TextBlock Text="Copyright 2026 Marco Seefeldt"
                               HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,8" />
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Hyperlink x:Name="GitHubLink"
                                   RequestNavigate="GitHubLink_RequestNavigate"
                                   NavigateUri="https://github.com/marcoseefeldt/clipwell-win">
                            github.com/marcoseefeldt/clipwell-win
                        </Hyperlink>
                    </TextBlock>
                    <Separator Margin="0,0,0,12" />
                    <TextBlock FontSize="11" Opacity="0.45" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340">
                        Native Windows, local-first, WPF / .NET 8, SQLite, Windows 10+
                    </TextBlock>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</ui:FluentWindow>
