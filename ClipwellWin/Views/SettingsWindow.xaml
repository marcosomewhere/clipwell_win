<ui:FluentWindow x:Class="ClipwellWin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Clipwell – Einstellungen"
        Width="760" Height="760"
        MinWidth="640" MinHeight="560"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Einstellungen"
                     ShowMinimize="False" ShowMaximize="False" />

        <TabControl Grid.Row="1" Margin="16,8,16,16"
                    Background="Transparent" BorderThickness="0">

            <!-- ═══════════════════════════════ Allgemein ══════════════════ -->
            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel Margin="0,12,0,0">

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Globaler Hotkey" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HotkeyStatusLabel" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Tastenkombination aufnehmen:" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox x:Name="HotkeyRecorderBox" IsReadOnly="True"
                                                Width="180" Margin="0,0,8,0"
                                                PreviewKeyDown="HotkeyRecorderBox_PreviewKeyDown" />
                                    <ui:Button Content="Übernehmen" Click="ApplyHotkey_Click"
                                               Appearance="Primary" />
                                </StackPanel>

                                <TextBlock Text="Oder manuell setzen:" Margin="0,12,0,6" />
                                <WrapPanel>
                                    <ui:ToggleSwitch x:Name="ModWin"   Margin="0,0,8,4" OffContent="Win"   OnContent="Win"   IsChecked="True" />
                                    <ui:ToggleSwitch x:Name="ModShift" Margin="0,0,8,4" OffContent="Shift" OnContent="Shift" IsChecked="True" />
                                    <ui:ToggleSwitch x:Name="ModCtrl"  Margin="0,0,8,4" OffContent="Ctrl"  OnContent="Ctrl" />
                                    <ui:ToggleSwitch x:Name="ModAlt"   Margin="0,0,0,4"  OffContent="Alt"   OnContent="Alt" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="+ Taste:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:TextBox x:Name="HotkeyChar" MaxLength="1" Width="50" Text="V"
                                                HorizontalContentAlignment="Center" Margin="0,0,8,0" />
                                    <ui:Button Content="Manuell übernehmen" Click="ApplyManualHotkey_Click" />
                                </StackPanel>

                                <TextBlock Text="Aktion beim Hotkey:" Margin="0,14,0,6" />
                                <ComboBox x:Name="HotkeyActionBox" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Nur Menü öffnen" />
                                    <ComboBoxItem Content="Neuesten Eintrag sofort einfügen" />
                                </ComboBox>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Farbschema" FontWeight="SemiBold" />
                                    <TextBlock Text="Welches Theme soll Clipwell verwenden?" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="ThemeBox" Width="150"
                                      SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Dunkel" />
                                <ComboBoxItem Content="Hell" />
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Erkennung" FontWeight="SemiBold" />
                                    <TextBlock Text="Wie aggressiv soll Code in kopierten Texten erkannt werden?" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="CodeModeBox" Width="180" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Konservativ" />
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="Aggressiv" />
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="History-Limit" FontWeight="SemiBold" />
                                    <TextBlock Text="Maximale Anzahl gespeicherter Einträge (50–5000)" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:NumberBox x:Name="MaxItemsBox" Value="500"
                                              PlaceholderText="500"
                                              Minimum="50" Maximum="5000"
                                              Width="100" Margin="0,0,8,0" />
                                <ui:Button Content="Speichern" Click="SaveGeneral_Click" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Überwachung pausieren" FontWeight="SemiBold" />
                                    <TextBlock Text="Clipboard-Änderungen werden nicht gespeichert" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="PauseSwitch" Click="PauseSwitch_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Popup-Position merken" FontWeight="SemiBold" />
                                    <TextBlock Text="Fenstergrösse und -position beim nächsten Öffnen wiederherstellen" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="RememberPositionSwitch" Click="RememberPosition_Click" />
                        </ui:CardControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Privatsphäre ══════════════ -->
            <TabItem Header="Privatsphäre">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel Margin="0,12,0,0">

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Inkognito-Modus" FontWeight="SemiBold" />
                                    <TextBlock Text="Nichts speichern – alle Clipboard-Änderungen ignorieren" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="IncognitoSwitch" Click="IncognitoSwitch_Click" />
                        </ui:CardControl>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Apps ausschliessen" FontWeight="SemiBold" />
                                    <TextBlock Text="Prozessnamen kommagetrennt – Clipboard wird für diese Apps nicht gespeichert" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <ui:TextBox x:Name="IncognitoAppsBox"
                                            PlaceholderText="z.B. KeePass, 1Password, bitwarden"
                                            AcceptsReturn="False" TextWrapping="Wrap"
                                            Margin="0,0,0,8" />
                                <ui:Button Content="Speichern" Click="SaveIncognitoApps_Click" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Domains ausschliessen" FontWeight="SemiBold" />
                                    <TextBlock Text="URLs dieser Domains werden nicht gespeichert (kommagetrennt)" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <ui:TextBox x:Name="IncognitoDomainsBox"
                                            PlaceholderText="z.B. bank.de, paypal.com"
                                            AcceptsReturn="False" TextWrapping="Wrap"
                                            Margin="0,0,0,8" />
                                <ui:Button Content="Speichern" Click="SaveIncognitoDomains_Click" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Sensible Inhalte filtern" FontWeight="SemiBold" />
                                    <TextBlock Text="API-Keys, Tokens, Passwörter und Private Keys automatisch nicht speichern" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="FilterSensitiveSwitch" Click="FilterSensitive_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="URL-Vorschau laden" FontWeight="SemiBold" />
                                    <TextBlock Text="Titel und Favicon kopierter URLs aus dem Netz abrufen. Aus = kein Netzwerkzugriff beim Kopieren." FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="UrlPreviewSwitch" Click="UrlPreview_Click" />
                        </ui:CardControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Daten ════════════════════ -->
            <TabItem Header="Daten">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel Margin="0,12,0,0">

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Speicherlimits" FontWeight="SemiBold" />
                                    <TextBlock Text="Ältere oder zu viele Einträge automatisch löschen (0 = deaktiviert)" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Maximales Alter (Tage)" FontWeight="SemiBold" />
                                        <TextBlock Text="Einträge älter als N Tage werden beim nächsten Start gelöscht" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <ui:NumberBox x:Name="MaxAgeBox" Grid.Column="1"
                                                  Value="0"
                                                  Minimum="0" Maximum="3650"
                                                  PlaceholderText="0" Width="100"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Maximale DB-Grösse (MB)" FontWeight="SemiBold" />
                                        <TextBlock Text="Älteste Einträge werden entfernt, wenn Datenbankgrösse überschritten" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <ui:NumberBox x:Name="MaxSizeBox" Grid.Column="1"
                                                  Value="0"
                                                  Minimum="0" Maximum="10240"
                                                  PlaceholderText="0" Width="100"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <ui:Button Content="Speichern" Click="SaveStorageLimits_Click" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False" x:Name="BackupExpander">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Sichern &amp; Wiederherstellen" FontWeight="SemiBold" />
                                    <TextBlock Text="Export, Import und automatische Backups verwalten" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">

                                <TextBlock Text="Manueller Export" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <ui:Button Content="Als JSON exportieren" Click="ExportJson_Click" Margin="0,0,8,0" />
                                    <ui:Button Content="SQLite-Backup exportieren" Click="ExportSqlite_Click" />
                                </StackPanel>

                                <TextBlock Text="Import" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <ui:Button Content="Aus JSON importieren" Click="ImportJson_Click" />
                                </StackPanel>

                                <Separator Margin="0,0,0,12" />

                                <TextBlock Text="Automatisches tägliches Backup" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Einmal täglich beim Start einen JSON-Export anlegen" FontSize="12" Opacity="0.6" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Auto-Backup aktivieren" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch x:Name="AutoBackupSwitch" Grid.Column="1"
                                                     Click="AutoBackupSwitch_Click" />
                                </Grid>

                                <TextBlock Text="Backup-Verzeichnis:" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:TextBox x:Name="AutoBackupDirBox" IsReadOnly="True" Width="260"
                                                PlaceholderText="Noch kein Verzeichnis gewählt"
                                                Margin="0,0,8,0" />
                                    <ui:Button Content="Durchsuchen…" Click="AutoBackupBrowse_Click" />
                                </StackPanel>
                                <TextBlock x:Name="AutoBackupStatusLabel" FontSize="12" Opacity="0.65" />

                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Zurücksetzen" FontWeight="SemiBold" />
                                    <TextBlock Text="Einzelne Bereiche sicher löschen (mit Bestätigung)" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <WrapPanel>
                                    <ui:Button Content="History löschen" Appearance="Caution"
                                               Click="ResetHistory_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="URL-Cache löschen" Appearance="Caution"
                                               Click="ResetUrlCache_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="Einstellungen zurücksetzen" Appearance="Caution"
                                               Click="ResetSettings_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:CardExpander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Tastenkürzel ══════════════ -->
            <TabItem Header="Tastenkürzel">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Popup-Aktionen konfigurieren" FontWeight="SemiBold"
                                   FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12">
Die folgenden Tastenkombinationen gelten für das Popup-Fenster. Enter, Esc und Pfeiltasten sind fest belegt.</TextBlock>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Eintrag pinnen" FontWeight="SemiBold" />
                                    <TextBlock Text="Standard: Ctrl+P" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch x:Name="PinCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                 IsChecked="True" Margin="0,0,8,0" />
                                <ui:TextBox x:Name="PinKeyBox" MaxLength="1" Width="50"
                                            HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Details öffnen" FontWeight="SemiBold" />
                                    <TextBlock Text="Standard: F2" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox x:Name="DetailsKeyBox" Width="80"
                                        PlaceholderText="F2" HorizontalContentAlignment="Center" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Schnellnotiz" FontWeight="SemiBold" />
                                    <TextBlock Text="Standard: Ctrl+N" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch x:Name="QuickNoteCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                 IsChecked="True" Margin="0,0,8,0" />
                                <ui:TextBox x:Name="QuickNoteKeyBox" MaxLength="1" Width="50"
                                            HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Pinboard öffnen/schließen" FontWeight="SemiBold" />
                                    <TextBlock Text="Standard: Ctrl+B" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch x:Name="PinboardCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                 IsChecked="True" Margin="0,0,8,0" />
                                <ui:TextBox x:Name="PinboardKeyBox" MaxLength="1" Width="50"
                                            HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:Button Content="Tastenkürzel speichern" Appearance="Primary"
                                   Click="SaveShortcuts_Click" Margin="0,8,0,0" />
                        <ui:Button Content="Auf Standard zurücksetzen"
                                   Click="ResetShortcuts_Click" Margin="0,8,0,16" />

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Tastaturhilfe" FontWeight="SemiBold" />
                                    <TextBlock Text="Alle Tastenkürzel auf einen Blick" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Popup" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,12">
Enter: Eintrag einfügen&#x0a;Ctrl+Enter: Plain Text einfügen&#x0a;Pfeil hoch/runter: Auswahl bewegen&#x0a;Ctrl+P: Eintrag pinnen&#x0a;Entf: Eintrag löschen&#x0a;Esc: Popup schließen</TextBlock>

                                <TextBlock Text="Erweiterte Suche" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,12">
type:url  – nur URLs anzeigen&#x0a;kind:json  – nur JSON-Einträge&#x0a;domain:github.com  – URLs einer Domain&#x0a;pinned:true / pinned:false  – nach Pin-Status filtern</TextBlock>

                                <TextBlock Text="Kontextmenü" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock LineHeight="22" TextWrapping="Wrap">
Rechtsklick auf einen Eintrag: Kopieren, Plain Copy, Pinnen, Löschen, URL neu laden, Detailansicht und manuelle Typkorrektur.</TextBlock>
                            </StackPanel>
                        </ui:CardExpander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Über ═════════════════════ -->
            <TabItem Header="Über">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Identity panel -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="16,32,16,32">

                            <Image x:Name="AboutLogoImage"
                                   Width="112" Height="112"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />

                            <TextBlock Text="Clipwell" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="für Windows" FontSize="12" Opacity="0.55"
                                       HorizontalAlignment="Center" Margin="0,0,0,20" />

                            <Separator Margin="0,0,0,16" />

                            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="11" Opacity="0.4" LineHeight="18">
                                from germany by&#x0a;marco seefeldt
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Right: Details -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20,24,20">

                            <TextBlock Text="Über Clipwell" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.65" FontSize="13"
                                       LineHeight="20" Margin="0,0,0,20">
                                Clipwell ist ein schneller und smarter Clipboard-Manager für Windows.
                                Erfasst, verwaltet und durchsucht alles was du kopierst –
                                mit tastaturgestützter Navigation und minimalem Aufwand.
                            </TextBlock>

                            <!-- Info table -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                                           Opacity="0.55" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AboutVersionLabel"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Build"
                                           Opacity="0.55" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AboutBuildLabel"
                                           FontSize="13" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Plattform"
                                           Opacity="0.55" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AboutPlatformLabel"
                                           FontSize="13" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Lizenz"
                                           Opacity="0.55" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Proprietär"
                                           FontSize="13" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Entwickler"
                                           Opacity="0.55" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Marco Seefeldt"
                                           FontSize="13" VerticalAlignment="Center" />

