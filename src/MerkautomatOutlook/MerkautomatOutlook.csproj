<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outlook (classic, 64 bit) loads COM add-ins into its .NET Framework runtime, so this project targets net48. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>MerkautomatOutlook</AssemblyName>
    <RootNamespace>MerkautomatOutlook</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Product>Merkautomat</Product>
    <AssemblyTitle>Merkautomat für Outlook</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Merkautomat\Infrastructure\Persistence\ToolDataPaths.cs" Link="ToolDataPaths.cs" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
