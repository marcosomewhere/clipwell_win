<Application x:Class="Merkautomat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- Ressourcen werden per ApplyTheme() aktualisiert. -->
            <Thickness x:Key="EntryItemMargin">8,2</Thickness>
            <Thickness x:Key="EntryContentMargin">12,8</Thickness>
            <sys:Double x:Key="EntryMinHeight">52</sys:Double>
            <sys:Double x:Key="EntryFontSizeMain">12.5</sys:Double>
            <sys:Double x:Key="EntryFontSizeMeta">11</sys:Double>
            <Thickness x:Key="FilterChipPadding">10,4</Thickness>
            <sys:Double x:Key="FilterChipFontSize">11</sys:Double>
            <SolidColorBrush x:Key="AccentBrush" Color="#FFE88832" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="AccentStripeBrush" Color="#D9E88832" />
            <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="PopupBorderBrush" Color="#FF262626" />
            <SolidColorBrush x:Key="PopupPanelBrush" Color="#FF121212" />
            <SolidColorBrush x:Key="PopupPanelBorderBrush" Color="#FF262626" />
            <SolidColorBrush x:Key="PopupTextPrimaryBrush" Color="#FFEDEDED" />
            <SolidColorBrush x:Key="PopupTextSecondaryBrush" Color="#D8EDEDED" />
            <SolidColorBrush x:Key="PopupTextMutedBrush" Color="#A8EDEDED" />
            <SolidColorBrush x:Key="PopupTextSubtleBrush" Color="#8AEDEDED" />
            <SolidColorBrush x:Key="PopupTextFaintBrush" Color="#66EDEDED" />
            <SolidColorBrush x:Key="PopupHoverBrush" Color="#FF161616" />
            <SolidColorBrush x:Key="PopupSelectedBrush" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="PopupChipBrush" Color="#FF141414" />
            <SolidColorBrush x:Key="PopupChipCheckedBrush" Color="#FF2A2A2A" />
            <SolidColorBrush x:Key="PopupBadgeBrush" Color="#FF242424" />
            <SolidColorBrush x:Key="PopupBadgeSecondaryBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="PopupShadowBrush" Color="#FF000000" />

            <SolidColorBrush x:Key="OnboardingBackgroundBrush" Color="#FFFAFAF8" />
            <SolidColorBrush x:Key="OnboardingSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OnboardingSurfaceAltBrush" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="OnboardingBorderBrush" Color="#FFE0E2E6" />
            <SolidColorBrush x:Key="OnboardingTextPrimaryBrush" Color="#FF15171A" />
            <SolidColorBrush x:Key="OnboardingTextSecondaryBrush" Color="#B815171A" />
            <SolidColorBrush x:Key="OnboardingTextMutedBrush" Color="#8A15171A" />
            <SolidColorBrush x:Key="OnboardingInputBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OnboardingInputFocusedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OnboardingButtonBrush" Color="#FF24282D" />
            <SolidColorBrush x:Key="OnboardingButtonHoverBrush" Color="#FF343A40" />
            <SolidColorBrush x:Key="OnboardingButtonTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OnboardingAccentBrush" Color="#FFE88832" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
