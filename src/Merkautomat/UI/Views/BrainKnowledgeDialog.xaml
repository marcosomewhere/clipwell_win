<Window x:Class="Merkautomat.Views.BrainKnowledgeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thema und Zusammenfassung – Ideenkombinat" Icon="/Merkautomat;component/Assets/kb-icon-16.png"
        Width="1120" Height="800" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EditorChromeBrush}" Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Wissen ordnen und zusammenfassen" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Quellen auswählen, ein gemeinsames Thema vergeben oder eine Zusammenfassung erstellen. Die Originale bleiben erhalten."
                       Style="{StaticResource BrainCaption}" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource BrainCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <Label Content="Themenname / Titel" Target="{Binding ElementName=TopicName}" Padding="0,0,0,6" />
                    <TextBox x:Name="TopicName" Style="{StaticResource BrainInput}" MaxLength="120" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Label Content="Kategorie (optional)" Target="{Binding ElementName=Category}" Padding="0,0,0,6" />
                    <ComboBox x:Name="Category" IsEditable="True" ToolTip="Kategorie wählen oder selbst eingeben" />
                </StackPanel>
                <Expander x:Name="LocalAiPanel" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="Collapsed" Header="Lokale KI · Kategorie und Titel vorschlagen">
                    <StackPanel Margin="0,8,0,0">
                    <WrapPanel>
                        <Button x:Name="AiSuggestButton" Content="Kategorie vorschlagen" Click="AiSuggest_Click" Style="{StaticResource EditorButtonStyle}" Padding="10,6" Margin="0,0,8,4" />
                        <Button x:Name="AiApplyButton" Content="KI-Vorschlag übernehmen" Click="AiApply_Click" Style="{StaticResource EditorButtonStyle}" Padding="10,6" Margin="0,0,8,4" IsEnabled="False" />
                        <Button x:Name="AiCancelButton" Content="Abbrechen" Click="AiCancel_Click" Style="{StaticResource EditorButtonStyle}" Padding="10,6" Margin="0,0,0,4" Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock x:Name="AiStatus" Style="{StaticResource BrainCaption}" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="68" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*" MinWidth="340"/></Grid.ColumnDefinitions>
            <Border x:Name="SourcePanel" Style="{StaticResource BrainCard}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="1 · Quellen auswählen" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectionCount" Style="{StaticResource BrainCaption}" Margin="0,4,0,10" />
                        <TextBox x:Name="SourceFilter" Style="{StaticResource BrainInput}" TextChanged="SourceFilter_Changed" ToolTip="Quellen nach Titel oder Inhalt filtern" AutomationProperties.Name="Quellen filtern" />
                        <TextBlock Text="Quellen nach Titel oder Inhalt filtern" Style="{StaticResource BrainCaption}" FontSize="11" Margin="0,3,0,8" />
                        <WrapPanel>
                            <Button Content="Sichtbare markieren" Click="All_Click" Style="{StaticResource EditorButtonStyle}" FontSize="12" Padding="8,5" Margin="0,0,6,0" />
                            <Button Content="Auswahl aufheben" Click="None_Click" Style="{StaticResource EditorButtonStyle}" FontSize="12" Padding="8,5" />
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="SourceList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource BrainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SourceList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox AutomationProperties.Name="Quelle auswählen" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BrainSourceCheck}" Click="SourceSelection_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source.Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" FontSize="13" FontWeight="SemiBold" ToolTip="{Binding Source.Title}" />
                                        <TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource EditorMutedBrush}" ToolTip="{Binding Reason}" />
                                        <TextBlock Text="{Binding Source.Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource EditorMutedBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="{DynamicResource EditorBorderBrush}" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="2 · Aktion wählen" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TabControl x:Name="KnowledgeMode" Grid.Row="1" SelectionChanged="KnowledgeMode_Changed">
                    <TabItem Header="Thema zuordnen">
                        <Border Style="{StaticResource BrainCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <TextBlock Text="Ein gemeinsames Thema" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Name und Kategorie werden auf alle markierten Quellen angewendet. So lassen sich Einträge gemeinsam ordnen. Es wird keine neue Sprachnotiz angelegt."
                                               Style="{StaticResource BrainCaption}" Margin="0,8,0,16" />
                                    <TextBlock Text="Quellenvorschau" FontWeight="SemiBold" />
                                    <TextBlock Text="Links einen Eintrag anklicken, um seinen Inhalt zu prüfen." Style="{StaticResource BrainCaption}" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBox x:Name="SourcePreview" Style="{StaticResource BrainInput}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                        </Border>
                    </TabItem>
                    <TabItem Header="Zusammenfassen">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Speicherziel" Style="{StaticResource BrainCaption}" Margin="0,0,0,5" />
                                <ComboBox x:Name="SummaryTarget" DisplayMemberPath="Label" SelectionChanged="SummaryTarget_SelectionChanged"
                                          ToolTip="Neue Sprachnotiz oder vorhandene Zusammenfassung" />
                                <TextBlock Text="Originalaussagen mit Quellenverweisen. Den Entwurf vor dem Speichern prüfen und bearbeiten." Style="{StaticResource BrainCaption}" Margin="0,8,0,0" />
                            </StackPanel>
                            <DockPanel Grid.Row="1" Margin="0,10">
                                <CheckBox x:Name="PreviewToggle" DockPanel.Dock="Right" Content="Vorschau" Style="{StaticResource EditorCheckBoxStyle}" VerticalAlignment="Center" Margin="12,0,0,0" Click="Preview_Click" />
                                <Button x:Name="GenerateButton" Content="Entwurf aus Auswahl erstellen" Click="Generate_Click" HorizontalAlignment="Left" Style="{StaticResource EditorButtonStyle}" />
                            </DockPanel>
                            <Grid Grid.Row="2">
                                <TextBox x:Name="SummaryText" Style="{StaticResource BrainInput}" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Draft_Changed" />
                                <RichTextBox x:Name="SummaryPreview" Visibility="Collapsed" IsReadOnly="True" IsDocumentEnabled="True"
                                             Background="{DynamicResource EditorTextBodyBrush}" Foreground="{DynamicResource EditorTextBrush}"
                                             BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Feedback" Style="{StaticResource BrainCaption}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Abbrechen" IsCancel="True" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="Zuordnung speichern" Click="Save_Click" Style="{StaticResource BrainPrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
