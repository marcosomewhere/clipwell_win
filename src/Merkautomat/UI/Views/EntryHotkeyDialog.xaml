<Window x:Class="Merkautomat.Views.EntryHotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkey zuweisen – Merkautomat"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource EditorChromeBrush}" Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Hotkey zuweisen" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="EntryText" Style="{StaticResource BrainCaption}" Margin="0,5,0,14" TextTrimming="CharacterEllipsis" />

        <TextBlock Text="Tastenkombination drücken" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="RecorderBox" IsReadOnly="True" FontSize="15" Padding="6,4"
                 AutomationProperties.Name="Tastenkombination"
                 ToolTip="Hier klicken und die gewünschte Kombination drücken, z. B. Ctrl+Alt+1"
                 PreviewKeyDown="RecorderBox_PreviewKeyDown" />
        <TextBlock Style="{StaticResource BrainCaption}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Buchstaben und Ziffern mit Ctrl, Alt oder Win; F-Tasten auch allein. Der Hotkey gilt in jedem Programm und fügt den Eintrag dort ein." />

        <CheckBox x:Name="PlainTextBox" Content="Als reinen Text einfügen (ohne Formatierung)" Margin="0,14,0,0" />

        <TextBlock Style="{StaticResource BrainCaption}" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Der Eintrag wird dabei gepinnt, damit ihn die automatische Bereinigung nicht löscht." />

        <TextBlock x:Name="ErrorText" Foreground="#FFE57373" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="RemoveButton" Content="Hotkey entfernen" Click="Remove_Click" Style="{StaticResource EditorButtonStyle}" />
            <Button Grid.Column="2" Content="Abbrechen" IsCancel="True" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Zuweisen" IsDefault="True" Click="Assign_Click" Style="{StaticResource BrainPrimaryButton}" />
        </Grid>
    </StackPanel>
</Window>
