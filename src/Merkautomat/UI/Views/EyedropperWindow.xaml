<Window x:Class="Merkautomat.Views.EyedropperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Cursor="Cross">
    <Canvas x:Name="RootCanvas"
            MouseMove="Canvas_MouseMove"
            MouseLeftButtonDown="Canvas_Click"
            KeyDown="Canvas_KeyDown"
            Focusable="True">
        <!-- Nearly transparent so the overlay still receives mouse input on every monitor. -->
        <Rectangle x:Name="Overlay"
                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                   Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                   Fill="#01000000" />

        <Border x:Name="PreviewBorder"
                CornerRadius="8" Padding="10,8"
                Background="#F00A0A0A"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                Width="168" Canvas.Left="20" Canvas.Top="20">
            <StackPanel>
                <Border x:Name="ColorPreviewBox" Height="40" CornerRadius="4" Margin="0,0,0,6"
                        BorderBrush="#33FFFFFF" BorderThickness="1" />
                <TextBlock x:Name="HexLabel" Text="#FFFFFF"
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="RgbLabel" Text="rgb(255, 255, 255)"
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="11" Foreground="#B3EDEDED"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Text="Klicken = auswählen  |  Esc = abbrechen"
                           FontSize="10" Foreground="#80EDEDED"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
