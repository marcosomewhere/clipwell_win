<Window x:Class="Merkautomat.Views.AppMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Merkautomat;component/Assets/AppLogo.png"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="620" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EditorChromeBrush}" Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Height="3" VerticalAlignment="Top" Background="{DynamicResource OnboardingAccentBrush}" />
        <Grid Margin="22,24,22,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Glyph" FontFamily="Segoe Fluent Icons" FontSize="26" Margin="0,0,16,0" VerticalAlignment="Top"
                       Foreground="{DynamicResource OnboardingAccentBrush}" />
            <ScrollViewer Grid.Column="1" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="MessageText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                         FontSize="13" Padding="0" Foreground="{DynamicResource EditorTextBrush}" IsTabStop="False" />
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource EditorPanelBrush}" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
