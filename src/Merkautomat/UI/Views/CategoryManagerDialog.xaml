<Window x:Class="Merkautomat.Views.CategoryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kategorien verwalten – Ideenkombinat" Icon="/Merkautomat;component/Assets/kb-icon-16.png"
        Width="900" Height="640" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EditorChromeBrush}" Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Kategorien verwalten" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource BrainCaption}" Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="Bis zu drei Ebenen: Hauptkategorie › Unterkategorie › Feinkategorie. Beschreibungen helfen den E5-Vorschlägen beim Unterscheiden. Umbenennen auf einen vorhandenen Namen führt beide zusammen." />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="6*" MinWidth="320"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource BrainCard}" Padding="12">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="Neue Hauptkategorie" Click="NewMain_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" />
                        <Button x:Name="NewSubButton" Content="Neue Unterebene" Click="NewSub_Click" Style="{StaticResource EditorButtonStyle}"
                                ToolTip="Unter einer Hauptkategorie eine Unterkategorie anlegen, unter einer Unterkategorie eine Feinkategorie" />
                    </WrapPanel>
                    <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource BrainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="CategoryList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="{Binding Indent}">
                                    <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource EditorMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource BrainCard}">
                <StackPanel x:Name="EditorPanel">
                    <TextBlock x:Name="EditorHeading" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="EditorInfo" Style="{StaticResource BrainCaption}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="NameBox" Style="{StaticResource BrainInput}" MaxLength="80" />
                    <StackPanel x:Name="ParentPanel" Margin="0,12,0,0">
                        <TextBlock x:Name="ParentLabel" Text="Gehört zu" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="ParentBox" IsEditable="True" ToolTip="Samt Einträgen und Feinkategorien unter eine andere übergeordnete Kategorie verschieben" />
                    </StackPanel>
                    <TextBlock Text="Beschreibung (optional)" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <TextBox x:Name="DescriptionBox" Style="{StaticResource BrainInput}" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="False"
                             MinHeight="70" VerticalScrollBarVisibility="Auto"
                             ToolTip="Wofür steht die Kategorie, was gehört nicht dazu? Wird beim Vergleich mit E5 zusammen mit dem Namen verwendet." />
                    <TextBlock x:Name="ErrorText" Foreground="#FFE57373" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="SaveButton" Content="Änderungen speichern" Click="Save_Click" Style="{StaticResource BrainPrimaryButton}" Margin="0,0,8,0" />
                        <Button x:Name="DeleteButton" Content="Löschen …" Click="Delete_Click" Style="{StaticResource EditorButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Feedback" Style="{StaticResource BrainCaption}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Schließen" IsCancel="True" Style="{StaticResource EditorButtonStyle}" />
        </Grid>
    </Grid>
</Window>
