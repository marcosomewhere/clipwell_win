<Window x:Class="Merkautomat.Views.CategoryDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kategorien analysieren – Ideenkombinat" Icon="/Merkautomat;component/Assets/kb-icon-16.png"
        Width="1000" Height="780" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EditorChromeBrush}" Foreground="{DynamicResource EditorTextBrush}" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="DiscoveryExpander" TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" Padding="10,8"
                                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Outline" Background="{DynamicResource EditorPanelAltBrush}" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Sign" Text="+" Margin="0,0,10,0" Foreground="{DynamicResource EditorTextBrush}" />
                                                    <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" TextElement.Foreground="{DynamicResource EditorTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Sign" Property="Text" Value="−" /></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Background" Value="{DynamicResource EditorHoverBrush}" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" Margin="0,10,0,0" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="DiscoveryEntry">
                <Border Background="{DynamicResource EditorPanelAltBrush}" CornerRadius="5" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource EditorTextBrush}" />
                        <TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,6,0,0" Foreground="{DynamicResource EditorTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded, ElementName=FullText}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Expander x:Name="FullText" Margin="0,8,0,0" FontSize="12">
                            <Expander.Style>
                                <Style TargetType="Expander" BasedOn="{StaticResource DiscoveryExpander}">
                                    <Setter Property="Header" Value="Vollständigen Text lesen" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMoreText}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <Trigger Property="IsExpanded" Value="True"><Setter Property="Header" Value="Text einklappen" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource EditorTextBodyBrush}" Foreground="{DynamicResource EditorTextBrush}" BorderThickness="0" Padding="10" FontSize="13"
                                     AutomationProperties.Name="Vollständiger Eintragstext" />
                        </Expander>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <Style x:Key="DiscoveryCard" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" Background="{DynamicResource EditorPanelBrush}" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource OnboardingAccentBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Kategorien analysieren" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource BrainCaption}" Margin="0,5,0,0"
                       Text="Prüfe die Themen und Inhalte jeder Gruppe. Du kannst den Kategorienamen ändern oder eine Gruppe abwählen. Gespeichert wird erst mit „Ausgewählte übernehmen“." />
            <TextBlock x:Name="ScopeText" Style="{StaticResource BrainCaption}" Margin="0,6,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource BrainCard}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                    <ProgressBar x:Name="Progress" Height="5" Margin="0,6,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="StartButton" Grid.Column="1" Content="Analyse starten" Click="Start_Click" Style="{StaticResource BrainPrimaryButton}" Margin="0,0,8,0" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="Abbrechen" Click="Cancel_Click" Style="{StaticResource EditorButtonStyle}" Visibility="Collapsed" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource BrainCard}" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock x:Name="ResultHeader" Text="Vorschläge" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource BrainCaption}" Margin="0,4,0,0"
                               Text="Pro Gruppe siehst du die Themen, die Begründung und drei Einträge mit Textauszügen. Weitere Einträge und vollständige Texte lassen sich aufklappen." />
                </StackPanel>
                <ListBox x:Name="ProposalList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DiscoveryCard}" Foreground="{DynamicResource EditorTextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Header}" FontSize="13" Foreground="{DynamicResource EditorMutedBrush}" />
                                    <CheckBox Content="Gruppe übernehmen" AutomationProperties.Name="Diese Gruppe übernehmen" IsChecked="{Binding Accepted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource BrainSourceCheck}" Click="Accepted_Click" Foreground="{DynamicResource EditorTextBrush}" />
                                </DockPanel>
                                <TextBlock Text="Themen in dieser Gruppe" Foreground="{DynamicResource EditorMutedBrush}" FontSize="12" />
                                <TextBlock Text="{Binding TopicSummary}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource EditorTextBrush}" Margin="0,4,0,10" />
                                <TextBlock Text="Begründung des Vorschlags" FontSize="12" Foreground="{DynamicResource EditorMutedBrush}" />
                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{DynamicResource EditorTextBrush}" Margin="0,4,0,14" />
                                <Border BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Als Kategorie zuordnen" FontSize="13" Foreground="{DynamicResource EditorTextBrush}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BrainInput}" MaxLength="80"
                                                 AutomationProperties.Name="Kategorie für diese Gruppe" ToolTip="Kategoriename, frei änderbar" TextChanged="Name_TextChanged" />
                                        <TextBlock Text="{Binding Kind}" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource EditorMutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Zugehörige Einträge" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource EditorTextBrush}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding PreviewEntries}" ItemTemplate="{StaticResource DiscoveryEntry}" />
                                <Expander Header="{Binding MoreEntriesLabel}" Margin="0,4,0,0" FontSize="13">
                                    <Expander.Style>
                                        <Style TargetType="Expander" BasedOn="{StaticResource DiscoveryExpander}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMore}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Expander.Style>
                                    <ItemsControl ItemsSource="{Binding AdditionalEntries}" ItemTemplate="{StaticResource DiscoveryEntry}" />
                                </Expander>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Feedback" Style="{StaticResource BrainCaption}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Grid.Column="1" Content="Schließen" IsCancel="True" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Grid.Column="2" Content="Ausgewählte übernehmen" Click="Apply_Click" Style="{StaticResource BrainPrimaryButton}" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
