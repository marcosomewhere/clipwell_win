<ui:FluentWindow x:Class="Merkautomat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Merkautomat – Kontrollstation"
        Width="760" Height="760"
        MinWidth="640" MinHeight="560"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Kontrollstation"
                     ShowMinimize="False" ShowMaximize="False" />

        <TabControl Grid.Row="1" Margin="16,8,16,16"
                    Background="Transparent" BorderThickness="0">

            <!-- ═══════════════════════════════ Allgemein ══════════════════ -->
            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel Margin="0,12,0,0">

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Globaler Hotkey" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HotkeyStatusLabel" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Tastenkombination aufnehmen:" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox x:Name="HotkeyRecorderBox" IsReadOnly="True"
                                                Width="180" Margin="0,0,8,0"
                                                PreviewKeyDown="HotkeyRecorderBox_PreviewKeyDown" />
                                    <ui:Button Content="Übernehmen" Click="ApplyHotkey_Click"
                                               Appearance="Primary" />
                                </StackPanel>

                                <TextBlock Text="Oder manuell setzen:" Margin="0,12,0,6" />
                                <WrapPanel>
                                    <ui:ToggleSwitch x:Name="ModWin"   Margin="0,0,8,4" OffContent="Win"   OnContent="Win"   IsChecked="True" />
                                    <ui:ToggleSwitch x:Name="ModShift" Margin="0,0,8,4" OffContent="Shift" OnContent="Shift" IsChecked="True" />
                                    <ui:ToggleSwitch x:Name="ModCtrl"  Margin="0,0,8,4" OffContent="Ctrl"  OnContent="Ctrl" />
                                    <ui:ToggleSwitch x:Name="ModAlt"   Margin="0,0,0,4"  OffContent="Alt"   OnContent="Alt" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="+ Taste:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:TextBox x:Name="HotkeyChar" MaxLength="1" Width="50" Text="V"
                                                HorizontalContentAlignment="Center" Margin="0,0,8,0" />
                                    <ui:Button Content="Manuell übernehmen" Click="ApplyManualHotkey_Click" />
                                </StackPanel>

                                <TextBlock Text="Aktion beim Hotkey:" Margin="0,14,0,6" />
                                <ComboBox x:Name="HotkeyActionBox" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Nur Menü öffnen" />
                                    <ComboBoxItem Content="Neuesten Eintrag sofort einfügen" />
                                </ComboBox>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Farbschema" FontWeight="SemiBold" />
                                    <TextBlock Text="Welches Theme soll der Merkautomat verwenden?" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="ThemeBox" Width="150"
                                      SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Dunkel" />
                                <ComboBoxItem Content="Hell" />
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Erkennung" FontWeight="SemiBold" />
                                    <TextBlock Text="Wie aggressiv soll Code in kopierten Texten erkannt werden?" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="CodeModeBox" Width="180" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Konservativ" />
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="Aggressiv" />
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="History-Limit" FontWeight="SemiBold" />
                                    <TextBlock Text="Maximale Anzahl gespeicherter Einträge (50–5000)" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBox x:Name="MaxItemsBox"
                                            Text="500"
                                            PlaceholderText="500"
                                            Width="100" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Überwachung pausieren" FontWeight="SemiBold" />
                                    <TextBlock Text="Clipboard-Änderungen werden nicht gespeichert" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="PauseSwitch" Click="PauseSwitch_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Windows-Autostart" FontWeight="SemiBold" />
                                    <TextBlock Text="Merkautomat beim Anmelden automatisch starten" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="StartWithWindowsSwitch" Click="StartWithWindows_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="URL-Vorschau laden" FontWeight="SemiBold" />
                                    <TextBlock Text="Titel und Favicon kopierter URLs aus dem Netz abrufen. Aus = kein Netzwerkzugriff beim Kopieren." FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="UrlPreviewSwitch" Click="UrlPreview_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Verschlüsselung und Notschlüssel" FontWeight="SemiBold" />
                                    <TextBlock Text="History, Sprachnotizen, Bildschirmaufnahmen, Aufgaben, Einstellungen und Auto-Backups liegen verschlüsselt auf der Platte, gebunden an dein Windows-Konto. Der Notschlüssel öffnet sie auch auf einem anderen PC." FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Notschlüssel anzeigen …" Click="ShowRecoveryKey_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Kopierte Dateien mit Inhalt speichern" FontWeight="SemiBold" />
                                    <TextBlock Text="Wird eine Datei (z. B. im Explorer) kopiert, übernimmt Merkautomat bei den unten genannten Dateitypen den Textinhalt; Dateiname und Pfad bleiben als Quelle am Eintrag. Aus = kopierte Dateien werden nicht gespeichert." FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="FileContentSwitch" Click="FileContent_Click" />
                        </ui:CardControl>

                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Lesbare Dateitypen" FontWeight="SemiBold" />
                                <TextBlock Text="Endungen durch Komma getrennt, ohne Punkt. Dateien ohne Endung zählen über ihren Namen (z. B. dockerfile, makefile). Binärdateien werden auch bei passender Endung übersprungen." FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,8" />
                                <ui:TextBox x:Name="FileContentExtensionsBox"
                                            TextWrapping="Wrap"
                                            AcceptsReturn="False"
                                            MinHeight="64"
                                            MaxHeight="140"
                                            VerticalScrollBarVisibility="Auto"
                                            LostFocus="FileContentExtensions_LostFocus" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Höchstgröße je Kopie / Ordnerdatei (KB)" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:TextBox x:Name="FileContentMaxKbBox" Grid.Column="1" Width="90"
                                                PlaceholderText="1024" LostFocus="FileContentExtensions_LostFocus" />
                                    <ui:Button Grid.Column="3" Content="Standardliste" Click="FileContentDefaults_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Knowledgeordner" FontWeight="SemiBold" />
                                <TextBlock Text="Ein lokaler Ordner mit Unterordnern. Freigegebene lesbare Dateitypen werden alle 15 Sekunden abgeglichen und automatisch in Suche und Brain aufgenommen. Originaldateien bleiben erhalten."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,4,0,8" />
                                <TextBlock x:Name="KnowledgeFolderPathLabel" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <ui:Button Content="Ordner wählen …" Click="KnowledgeFolderChoose_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="Entfernen" Click="KnowledgeFolderRemove_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="Jetzt abgleichen" Click="KnowledgeFolderRefresh_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                                <ui:ToggleSwitch x:Name="KnowledgeFolderSwitch" Content="Synchronisierung aktiv" Click="KnowledgeFolderEnabled_Click" />
                                <TextBlock x:Name="KnowledgeFolderStatusLabel" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                                <TextBlock Text="Brain: maximale Einträge" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <TextBlock Text="100 bis 10.000, Standard 1.000. Größere Netze benötigen deutlich mehr Rechenzeit. Die neuesten Einträge der gewählten Quellen werden angezeigt."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="BrainMaxNodesBox" Width="120" HorizontalAlignment="Left"
                                            AutomationProperties.Name="Maximale Einträge im Brain" LostFocus="BrainMaxNodes_LostFocus" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Mein Wissen" FontWeight="SemiBold" />
                                <TextBlock Text="Einmal am Tag werden alle Quellen gewichtet und mit eigener Kopie übernommen: Knowledgeordner zählt am meisten, dann Sprachnotizen, Bildschirmaufnahmen und zuletzt die Zwischenablage. Was lange relevant bleibt, wird gefestigt. Eingeordnete, behaltene und gefestigte Einträge bleiben, alles andere wird nach der Aufbewahrungszeit zu Monatszusammenfassungen verdichtet. Der Knowledgeordner hat keine Fristen. Die Quellen selbst werden nie verändert."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,4,0,8" />
                                <ui:ToggleSwitch x:Name="MyKnowledgeSwitch" Content="Täglich übernehmen" Click="MyKnowledgeSettings_Changed" />
                                <TextBlock Text="Wartezeit in Stunden" FontWeight="SemiBold" Margin="0,14,0,4" />
                                <TextBlock Text="0 bis 168 (eine Woche), Standard 48. Erst wenn ein Eintrag so lange in der Wissensbasis ist, erscheint er in Mein Wissen; danach zählt er zunächst nur 30 % und erreicht sein volles Gewicht nach 14 Tagen."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="MyKnowledgeMaturityBox" Width="120" HorizontalAlignment="Left"
                                            AutomationProperties.Name="Wartezeit für Mein Wissen in Stunden" LostFocus="MyKnowledgeSettings_Changed" />
                                <TextBlock Text="Aufbewahrung in Tagen" FontWeight="SemiBold" Margin="0,14,0,4" />
                                <TextBlock Text="0 bis 3.650, Standard 60. Gilt nicht für den Knowledgeordner. Nicht eingeordnete Einträge mit wenig Gewicht werden danach verdichtet oder entfernt. 0 = nie."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="MyKnowledgeRetentionBox" Width="120" HorizontalAlignment="Left"
                                            AutomationProperties.Name="Aufbewahrung in Mein Wissen in Tagen" LostFocus="MyKnowledgeSettings_Changed" />
                                <ui:ToggleSwitch x:Name="MyKnowledgeCondenseSwitch" Margin="0,10,0,0" Click="MyKnowledgeSettings_Changed"
                                                 Content="Statt entfernen zusammenfassen (Einzelheiten gehen verloren)"
                                                 ToolTip="Je Monat und Kategorie (ohne Kategorie: je Quelle) eine Zusammenfassung mit ausgewählten Originalaussagen und Titeln" />
                                <TextBlock Text="Zwischenablage: Halbwertszeit in Tagen" FontWeight="SemiBold" Margin="0,14,0,4" />
                                <TextBlock Text="1 bis 365, Standard 7. Nach so vielen Tagen zählt ein Zwischenablage-Eintrag nur noch halb so viel; erneutes Kopieren, Anheften, eine Kategorie oder Mappe heben das Gewicht."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="MyKnowledgeHalfLifeBox" Width="120" HorizontalAlignment="Left"
                                            AutomationProperties.Name="Halbwertszeit der Zwischenablage in Tagen" LostFocus="MyKnowledgeSettings_Changed" />
                                <WrapPanel Margin="0,12,0,0">
                                    <ui:Button Content="Jetzt aktualisieren" Click="MyKnowledgeRun_Click" Margin="0,0,8,0" />
                                </WrapPanel>
                                <TextBlock x:Name="MyKnowledgeStatusLabel" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Desktop-Aufnahme: nur Seiteninhalt" FontWeight="SemiBold" />
                                    <TextBlock Text="Im Browser nur URL und Seiteninhalt aufzeichnen, ohne Tabs, Symbolleisten und Navigationsbereiche. Aus = alles Sichtbare." FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="RecordingContentOnlySwitch" Click="RecordingContentOnly_Click" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="URL-Cache-Dauer" FontWeight="SemiBold" />
                                    <TextBlock Text="Tage, bis Titel und Favicons neu geladen werden" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox x:Name="UrlCacheTtlBox"
                                        Text="7"
                                        PlaceholderText="7"
                                        Width="90"
                                        VerticalAlignment="Center" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Diktat (Whisper, lokal)" FontWeight="SemiBold" />
                                    <TextBlock Text="Modell für Sprachnotizen. Wird beim ersten Diktat nach data\models geladen; Audio bleibt auf dem Rechner." FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="DictationModelBox" Width="190" Margin="0,0,8,0"
                                          SelectionChanged="Dictation_SelectionChanged">
                                    <ComboBoxItem Content="Base (~145 MB, schnell)" Tag="base" />
                                    <ComboBoxItem Content="Small (~470 MB, genauer)" Tag="small" />
                                    <ComboBoxItem Content="Medium (~1,5 GB, langsam)" Tag="medium" />
                                </ComboBox>
                                <ComboBox x:Name="DictationLanguageBox" Width="130"
                                          SelectionChanged="Dictation_SelectionChanged">
                                    <ComboBoxItem Content="Deutsch" Tag="de" />
                                    <ComboBoxItem Content="Englisch" Tag="en" />
                                    <ComboBoxItem Content="Automatisch" Tag="auto" />
                                </ComboBox>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Speicherlimits" FontWeight="SemiBold" />
                                    <TextBlock Text="Ältere oder zu viele Einträge automatisch löschen (0 = deaktiviert)" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Maximales Alter (Tage)" FontWeight="SemiBold" />
                                        <TextBlock Text="Einträge älter als N Tage werden beim nächsten Start gelöscht" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <ui:TextBox x:Name="MaxAgeBox" Grid.Column="1"
                                                Text="0"
                                                PlaceholderText="0" Width="100"
                                                VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Maximale DB-Grösse (MB)" FontWeight="SemiBold" />
                                        <TextBlock Text="Älteste Einträge werden entfernt, wenn Datenbankgrösse überschritten" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <ui:TextBox x:Name="MaxSizeBox" Grid.Column="1"
                                                Text="0"
                                                PlaceholderText="0" Width="100"
                                                VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False" x:Name="BackupExpander">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Sichern &amp; Wiederherstellen" FontWeight="SemiBold" />
                                    <TextBlock Text="Export, Import und automatische Backups verwalten" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">

                                <TextBlock Text="Manueller Export" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock Text="Unverschlüsselt, zum Weiterverwenden in anderen Programmen. Speicherort mit Bedacht wählen." FontSize="12" Opacity="0.6" Margin="0,0,0,6" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:Button Content="Als JSON exportieren" Click="ExportJson_Click" Margin="0,0,8,0" />
                                    <ui:Button Content="SQLite-Backup exportieren" Click="ExportSqlite_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <ui:Button Content="Als CSV exportieren" Click="ExportCsv_Click" Margin="0,0,8,0" />
                                    <ui:Button Content="Als Markdown exportieren" Click="ExportMarkdown_Click" />
                                </StackPanel>

                                <TextBlock Text="Import" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <ui:Button Content="Aus JSON importieren" Click="ImportJson_Click" />
                                </StackPanel>

                                <Separator Margin="0,0,0,12" />

                                <TextBlock Text="Automatisches tägliches Backup" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Einmal täglich beim Start einen verschlüsselten JSON-Export anlegen; auf einem anderen PC öffnet ihn der Notschlüssel" FontSize="12" Opacity="0.6" Margin="0,0,0,10" TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Auto-Backup aktivieren" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch x:Name="AutoBackupSwitch" Grid.Column="1"
                                                     Click="AutoBackupSwitch_Click" />
                                </Grid>

                                <TextBlock Text="Backup-Verzeichnis:" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:TextBox x:Name="AutoBackupDirBox" IsReadOnly="True" Width="260"
                                                PlaceholderText="Noch kein Verzeichnis gewählt"
                                                Margin="0,0,8,0" />
                                    <ui:Button Content="Durchsuchen…" Click="AutoBackupBrowse_Click" />
                                </StackPanel>
                                <TextBlock x:Name="AutoBackupStatusLabel" FontSize="12" Opacity="0.65" />

                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="Zurücksetzen" FontWeight="SemiBold" />
                                    <TextBlock Text="Einzelne Bereiche sicher löschen (mit Bestätigung)" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <WrapPanel>
                                    <ui:Button Content="Ungepinnte History löschen" Appearance="Caution"
                                               Click="ResetHistory_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="Gesamte History löschen" Appearance="Caution"
                                               Click="ResetAllHistory_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="URL-Cache löschen" Appearance="Caution"
                                               Click="ResetUrlCache_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="Einstellungen zurücksetzen" Appearance="Caution"
                                               Click="ResetSettings_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:CardExpander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Tastenkürzel ══════════════ -->
            <TabItem Header="Tastenkürzel">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Popup-Aktionen konfigurieren" FontWeight="SemiBold"
                                   FontSize="14" Margin="0,0,0,6" />
                        <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16">
Diese Tastenkombinationen wirken im Popup-Fenster. Enter, Esc und Pfeiltasten sind fest belegt.
Win wird vom System abgefangen und eignet sich nur in Ausnahmefällen.</TextBlock>

                        <!-- Eintrag pinnen -->
                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Eintrag pinnen" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="Standard: Ctrl+P"
                                               FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ui:ToggleSwitch x:Name="PinCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                     IsChecked="True" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="PinAltSwitch" OffContent="Alt" OnContent="Alt"
                                                     IsChecked="False" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="PinShiftSwitch" OffContent="Shift" OnContent="Shift"
                                                     IsChecked="False" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="PinWinSwitch" OffContent="Win" OnContent="Win"
                                                     IsChecked="False" Margin="0,0,0,0" />
                                    <Rectangle Width="1" Height="28" Margin="16,0"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Taste" VerticalAlignment="Center"
                                               Margin="0,0,8,0" Opacity="0.65" FontSize="12" />
                                    <ui:TextBox x:Name="PinKeyBox" MaxLength="1" Width="64" FontSize="14"
                                                HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Details öffnen -->
                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Details öffnen" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="Standard: F2"
                                               FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ui:ToggleSwitch x:Name="DetailsCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                     IsChecked="False" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="DetailsAltSwitch" OffContent="Alt" OnContent="Alt"
                                                     IsChecked="False" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="DetailsShiftSwitch" OffContent="Shift" OnContent="Shift"
                                                     IsChecked="False" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="DetailsWinSwitch" OffContent="Win" OnContent="Win"
                                                     IsChecked="False" Margin="0,0,0,0" />
                                    <Rectangle Width="1" Height="28" Margin="16,0"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Taste" VerticalAlignment="Center"
                                               Margin="0,0,8,0" Opacity="0.65" FontSize="12" />
                                    <ui:TextBox x:Name="DetailsKeyBox" MaxLength="3" Width="64" FontSize="14"
                                                PlaceholderText="F2" HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Schnellnotiz -->
                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Schnellnotiz" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="Standard: Ctrl+N"
                                               FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ui:ToggleSwitch x:Name="QuickNoteCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                     IsChecked="True" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="QuickNoteAltSwitch" OffContent="Alt" OnContent="Alt"
                                                     IsChecked="False" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="QuickNoteShiftSwitch" OffContent="Shift" OnContent="Shift"
                                                     IsChecked="False" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="QuickNoteWinSwitch" OffContent="Win" OnContent="Win"
                                                     IsChecked="False" Margin="0,0,0,0" />
                                    <Rectangle Width="1" Height="28" Margin="16,0"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Taste" VerticalAlignment="Center"
                                               Margin="0,0,8,0" Opacity="0.65" FontSize="12" />
                                    <ui:TextBox x:Name="QuickNoteKeyBox" MaxLength="1" Width="64" FontSize="14"
                                                HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Pinboard öffnen/schließen -->
                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pinstation öffnen/schließen" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="Standard: Ctrl+B"
                                               FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ui:ToggleSwitch x:Name="PinboardCtrlSwitch" OffContent="Ctrl" OnContent="Ctrl"
                                                     IsChecked="True" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="PinboardAltSwitch" OffContent="Alt" OnContent="Alt"
                                                     IsChecked="False" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="PinboardShiftSwitch" OffContent="Shift" OnContent="Shift"
                                                     IsChecked="False" Margin="0,0,10,0" />
                                    <ui:ToggleSwitch x:Name="PinboardWinSwitch" OffContent="Win" OnContent="Win"
                                                     IsChecked="False" Margin="0,0,0,0" />
                                    <Rectangle Width="1" Height="28" Margin="16,0"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Taste" VerticalAlignment="Center"
                                               Margin="0,0,8,0" Opacity="0.65" FontSize="12" />
                                    <ui:TextBox x:Name="PinboardKeyBox" MaxLength="1" Width="64" FontSize="14"
                                                HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ui:Button Content="Auf Standard zurücksetzen"
                                   Click="ResetShortcuts_Click" Margin="0,8,0,16" />

                        <!-- Globale Hotkeys fuer einzelne Eintraege -->
                        <TextBlock Text="Hotkeys für Einträge" FontWeight="SemiBold"
                                   FontSize="14" Margin="0,8,0,6" />
                        <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Globale Tastenkombinationen, die einen bestimmten Eintrag in jedem Programm einfügen. Zuweisen per Rechtsklick auf einen Eintrag im Popup → Hotkey zuweisen …; der Eintrag wird dabei gepinnt." />
                        <Border Margin="0,0,0,16" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Eintrags-Hotkeys aktiv" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="EntryHotkeysSummary" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="EntryHotkeysSwitch" VerticalAlignment="Center"
                                                     AutomationProperties.Name="Eintrags-Hotkeys aktiv"
                                                     Checked="EntryHotkeysSwitch_Changed" Unchecked="EntryHotkeysSwitch_Changed" />
                                </Grid>

                                <ItemsControl x:Name="EntryHotkeyList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Hotkey}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.6" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" Content="Ändern …" Tag="{Binding EntryId}"
                                                           Click="ChangeEntryHotkey_Click" Margin="0,0,6,0" />
                                                <ui:Button Grid.Column="3" Content="Entfernen" Tag="{Binding EntryId}"
                                                           Click="RemoveEntryHotkey_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ui:Button x:Name="RemoveAllEntryHotkeysButton" Content="Alle entfernen"
                                           Click="RemoveAllEntryHotkeys_Click" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lokale KI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,20,12,16">
                        <StackPanel.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </ResourceDictionary>
                        </StackPanel.Resources>
                        <TextBlock Text="Themen entdecken und Wissen einordnen" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Neue Themen: E5 erkennt ähnliche Inhalte, Merkautomat gruppiert sie, und ein Sprachmodell schlägt Kategorienamen vor. Nach deiner Bestätigung kann E5 aus den Zuordnungen lernen und weitere Einträge einordnen. Du entscheidest, was gespeichert wird." Margin="0,8,0,20" Opacity="0.75" />
                        <TextBlock Text="Modell zum Einordnen" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ComboBox x:Name="LocalAiModelBox" HorizontalAlignment="Stretch" SelectionChanged="LocalAiModel_Changed" AutomationProperties.Name="Modell zum Einordnen">
                            <ComboBoxItem Tag="off" Content="Aus" />
                            <ComboBoxItem Tag="e5-categories" Content="E5 · bestehende Kategorien (schnell, mitgeliefert)" />
                            <ComboBoxItem Tag="minilm-l6" Content="MiniLM L6 · bestehende Kategorien (vorwiegend Englisch)" />
                            <ComboBoxItem Tag="horizon-zeroshot-small" Content="Horizon ZeroShot Small · bestehende Kategorien (mehrsprachig)" />
                            <ComboBoxItem Tag="granite-4.2-3b" Content="Granite 4.2 3B · lokal (CPU/GPU)" />
                            <ComboBoxItem Tag="qwen3.5-2b" Content="Qwen3.5-2B · lokal (CPU/GPU, kleiner Download)" />
                        </ComboBox>
                        <TextBlock x:Name="LocalAiModelHint" Margin="0,12,0,16" Opacity="0.75" />
                        <Border Style="{StaticResource BrainCard}">
                            <StackPanel>
                                <TextBlock x:Name="LocalAiStatus" FontWeight="SemiBold" Text="Lokale KI ausgeschaltet." />
                                <ProgressBar x:Name="LocalAiProgressBar" Minimum="0" Maximum="100" Height="6" Margin="0,12,0,0" Visibility="Collapsed" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="LocalAiDownloadButton" Content="Modell herunterladen" Click="LocalAiDownload_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" />
                                    <Button x:Name="LocalAiTestButton" Content="Funktion testen" Click="LocalAiTest_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" />
                                    <Button x:Name="LocalAiEvaluateButton" Content="Auswertung öffnen …" Click="LocalAiEvaluate_Click" Style="{StaticResource EditorButtonStyle}" Visibility="Collapsed" Margin="0,0,8,8"
                                            ToolTip="Verfahren auf deinen gespeicherten Zuordnungen vergleichen, Verfahren wählen und Praxiswerte ansehen" />
                                    <Button x:Name="LocalAiCancelButton" Content="Abbrechen" Click="LocalAiCancel_Click" Style="{StaticResource EditorButtonStyle}" Visibility="Collapsed" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Prompts der lokalen KI" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <TextBlock Text="Jede Aufgabe von Granite und Qwen hat ihren eigenen Prompt. Die Antwortfelder gibt Merkautomat fest vor; ein Prompt ändert Regeln und Formulierung, nicht das Format. Die Inhalte gehen als Daten mit, nicht als Anweisung. E5, MiniLM und Horizon verwenden keinen Prompt. Gespeichert wird beim Verlassen des Feldes oder beim Wechsel der Aufgabe."
                                   Margin="0,0,0,10" Opacity="0.75" />
                        <ComboBox x:Name="PromptBox" HorizontalAlignment="Stretch" SelectionChanged="PromptBox_SelectionChanged"
                                  AutomationProperties.Name="Prompt auswählen" DisplayMemberPath="Name" />
                        <TextBlock x:Name="PromptUsedFor" Margin="0,8,0,0" Opacity="0.75" />
                        <TextBlock x:Name="PromptData" Margin="0,4,0,8" Opacity="0.75" />
                        <TextBox x:Name="CategorizationPromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="320"
                                 VerticalScrollBarVisibility="Auto" FontSize="12" Padding="8,6" LostFocus="CategorizationPrompt_LostFocus"
                                 AutomationProperties.Name="Text des gewählten Prompts" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Standard wiederherstellen" Click="CategorizationPromptReset_Click"
                                    Style="{StaticResource EditorButtonStyle}" />
                            <TextBlock x:Name="CategorizationPromptState" VerticalAlignment="Center" Opacity="0.75" />
                        </DockPanel>
                        <TextBlock Text="Sprachmodell für Themen und Antworten" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <TextBlock Text="Unabhängig vom Einordnungsmodell: benennt Gruppen bei „Kategorien analysieren“ und beantwortet Fragen aus deinen Quellen. Die Gruppierung verwendet weiterhin das mitgelieferte E5-Modell." Margin="0,0,0,10" Opacity="0.75" />
                        <ComboBox x:Name="LanguageModelBox" HorizontalAlignment="Stretch" SelectionChanged="LanguageModel_Changed" AutomationProperties.Name="Sprachmodell für Themen und Antworten">
                            <ComboBoxItem Tag="granite-4.2-3b" Content="Granite 4.2 3B · lokal (CPU/GPU)" />
                            <ComboBoxItem Tag="qwen3.5-2b" Content="Qwen3.5-2B · lokal (CPU/GPU, kleiner Download)" />
                        </ComboBox>
                        <TextBlock x:Name="LanguageModelStatus" Margin="0,10,0,0" Opacity="0.75" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="LanguageModelDownloadButton" Content="Sprachmodell herunterladen" Click="LanguageModelDownload_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" />
                            <Button x:Name="LanguageModelTestButton" Content="Sprachmodell testen" Click="LanguageModelTest_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="CPU und GPU" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <ComboBox x:Name="AiComputeModeBox" SelectionChanged="AiComputeMode_Changed" AutomationProperties.Name="Ausführung des Sprachmodells">
                            <ComboBoxItem Tag="auto" Content="Automatisch: schnellste gemessene sichere Variante" />
                            <ComboBoxItem Tag="gpu" Content="GPU bevorzugen, bei Bedarf CPU" />
                            <ComboBoxItem Tag="cpu" Content="Nur CPU" />
                        </ComboBox>
                        <TextBlock Text="Granite und Qwen können die GPU über Vulkan nutzen. E5, Einordnung und Suche bleiben auf der CPU. Der Vergleich verwendet ausschließlich künstliche Texte und kann mehrere Minuten dauern." Margin="0,10,0,0" Opacity="0.75" />
                        <TextBlock x:Name="AiHardwareText" Margin="0,10,0,0" />
                        <TextBlock x:Name="AiExecutionStatus" Margin="0,10,0,0" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="GpuRuntimeButton" Content="GPU-Unterstützung laden (38 MB)" Click="GpuRuntime_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" />
                            <Button x:Name="AiBenchmarkButton" Content="CPU/GPU vergleichen" Click="AiBenchmark_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="Hintergrundarbeit" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <TextBlock Text="Das Sprachmodell bereitet „Kategorien analysieren“ vor und formuliert für Mein Wissen Titel, Kategorievorschläge, Monatszusammenfassungen und den Wochenrückblick, während du den PC nicht brauchst. Fertige Vorschläge meldet das Tray-Symbol; im Ideenkombinat öffnen sie sich ohne Wartezeit. Gespeichert wird weiterhin erst nach deiner Bestätigung. Nutzt das separat gewählte Sprachmodell für Themen und Antworten. Benötigt das installierte Sprachmodell." Margin="0,0,0,10" Opacity="0.75" />
                        <ComboBox x:Name="BackgroundModeBox" HorizontalAlignment="Stretch" SelectionChanged="BackgroundMode_Changed">
                            <ComboBoxItem Tag="off" Content="Aus" />
                            <ComboBoxItem Tag="idle" Content="Nur im Leerlauf (5 Minuten ohne Eingabe)" />
                            <ComboBoxItem Tag="always" Content="Auch während der Arbeit, sparsam" />
                        </ComboBox>
                        <CheckBox x:Name="BackgroundKeepAwakeBox" Content="PC nicht in den Energiesparmodus wechseln lassen, solange gerechnet wird" Margin="0,10,0,0"
                                  Checked="BackgroundKeepAwake_Changed" Unchecked="BackgroundKeepAwake_Changed" />
                        <Border Style="{StaticResource BrainCard}" Margin="0,10,0,0">
                            <TextBlock x:Name="BackgroundStatusText" Text="" />
                        </Border>
                        <TextBlock Text="Rücksicht: Das Sprachmodell läuft immer mit niedriger Priorität; während du arbeitest oder ein Video im Vollbild läuft, zusätzlich im Windows-Sparmodus (EcoQoS, bevorzugt Effizienzkerne). Im Akkubetrieb, bei Vollbildspielen und Präsentationen pausiert die Hintergrundarbeit sofort, bei direkter Nutzung der lokalen KI für drei Minuten. Nach einer Pause geht es mit der nächsten Gruppe weiter; fertige Gruppen bleiben erhalten." Margin="0,10,0,0" Opacity="0.75" />
                        <TextBlock Text="So funktioniert es" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <TextBlock Text="Im Brain bei „Thema zuordnen“ oder „Zusammenfassen“ erstellt die aktivierte KI automatisch einen Vorschlag. „KI-Vorschlag übernehmen“ setzt die Kategorie; bei Granite und Qwen auch den Titel. Erst das anschließende Speichern schreibt die Änderung. E5 benötigt mindestens zwei bereits gespeicherte Kategorien. Mit „Mit lokaler KI einordnen …“ im Brain, „Ohne Kategorie einordnen …“ und „Markierte einordnen …“ in der Suche lassen sich auch viele Einträge nacheinander bestätigen." Opacity="0.75" />
                        <TextBlock Text="Noch keine Kategorien? Im Ideenkombinat „Mehr → Kategorien analysieren …“ gruppiert die Einträge und lässt das separat gewählte Sprachmodell Kategorien vorschlagen. E5 lernt aus deinen gespeicherten Zuordnungen (Rocchio-Prototypen: Kategoriename plus Mittel der eigenen Beispiele). Breite Kategorien bekommen bis zu drei Schwerpunkte, als Vergleichsverfahren. „Auswertung öffnen …“ vergleicht alle Verfahren (Rocchio mit und ohne Namen, mehrere Prototypen, k-NN, logistische Regression) auf deinen Zuordnungen; „Automatisch“ nimmt das einfachste, außer ein anderes ist messbar besser. Die Werte sind Ähnlichkeiten, keine Wahrscheinlichkeiten." Margin="0,10,0,0" Opacity="0.75" />
                        <TextBlock Text="Auswertung: bis zu acht unterschiedliche Quellenauszüge mit je 700 Zeichen. Bei unklaren oder gemischten Treffern bleibt die Kategorie offen. Kein automatisches Training aus Brain-Verbindungen. Bestehende Zuordnungen und Originale werden nicht automatisch geändert." Margin="0,10,0,0" Opacity="0.75" />
                        <TextBlock Text="Datenschutz und Lizenz" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <TextBlock Text="Die Auswertung erfolgt lokal. Nur Modelldownloads benötigen Internet. Das Sprachmodell gibt nach drei Minuten Leerlauf seinen Modellspeicher frei; ein Modellwechsel oder „Aus“ beendet den laufenden Prozess. E5 teilt das bereits vorhandene Modell mit der Suche." Opacity="0.75" />
                        <TextBlock Text="E5: MIT · Granite, Qwen, MiniLM und Horizon: Apache 2.0 · llama.cpp: MIT. Keine Lizenzgebühren. Lizenzhinweise stehen in THIRD-PARTY-NOTICES.txt und im Ordner Licenses neben der Anwendung." Margin="0,10,0,0" Opacity="0.75" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Outlook">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,20,12,16">
                        <StackPanel.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </ResourceDictionary>
                        </StackPanel.Resources>
                        <TextBlock Text="Aufgaben aus Outlook" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Ein kleines Add-in für das klassische Outlook (Microsoft 365, Desktop) ergänzt das Kontextmenü einer Mail um „Aufgabe in Merkautomat erstellen“. Betreff, Absender, Datum und Text der Mail werden an Merkautomat übergeben und landen als Aufgabe im Ideenkombinat." Margin="0,8,0,20" Opacity="0.75" />
                        <Border Style="{StaticResource BrainCard}">
                            <StackPanel>
                                <TextBlock x:Name="OutlookAddinStatus" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="OutlookAddinInstallButton" Content="Add-in einrichten" Click="OutlookAddinInstall_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" />
                                    <Button x:Name="OutlookAddinReenableButton" Content="Wieder aktivieren" Click="OutlookAddinReenable_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" Visibility="Collapsed"
                                            ToolTip="Outlook hat das Add-in abgeschaltet; beim nächsten Start erneut laden" />
                                    <Button x:Name="OutlookAddinRemoveButton" Content="Add-in entfernen" Click="OutlookAddinRemove_Click" Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="So funktioniert es" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <TextBlock Text="Nach dem Einrichten Outlook neu starten. Dann Rechtsklick auf eine Mail (oder mehrere markierte, bis zu 20) → „Aufgabe in Merkautomat erstellen“. Der Titel ist der Betreff ohne AW:/WG:, der Mailtext steht als Quelle bei der Aufgabe (bis 4000 Zeichen). Läuft Merkautomat nicht, startet das Add-in ihn; sonst holt Merkautomat die Mail beim nächsten Start ab." Opacity="0.75" />
                        <TextBlock Text="Eingerichtet wird nur für deinen Windows-Benutzer, ohne Adminrechte. Das Add-in wird nach data\outlook kopiert. Nach einem Merkautomat-Update „Add-in einrichten“ erneut wählen, bei geschlossenem Outlook." Margin="0,10,0,0" Opacity="0.75" />
                        <TextBlock Text="Datenschutz" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <TextBlock Text="Das Add-in liest nur die Mails, die du über das Kontextmenü übergibst, und nur deren Betreff, Absendername, Empfangszeit und Text, keine Anhänge. Die Übergabe läuft über eine Datei in data\inbox, die Merkautomat sofort wieder löscht. Nichts verlässt den Rechner. Das neue Outlook unterstützt solche Add-ins nicht. Lässt eine Firmenrichtlinie nur freigegebene Add-ins zu, lädt Outlook es nicht." Opacity="0.75" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Über">
                <Border Margin="0,12,0,0"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="8,0,0,8"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,1,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="AboutCover_MouseLeftButtonUp"
                                ToolTip="Klicken für die Bildergeschichte zur Entstehung">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/about-cover.jpg"
                                            Stretch="UniformToFill"
                                            AlignmentX="Center"
                                            AlignmentY="Top" />
                            </Border.Background>
                        </Border>

                        <Grid Grid.Column="1" Margin="26,22,26,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                                <TextBlock Text="Nichts geht mehr verloren"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap"
                                           Opacity="0.75"
                                           FontSize="13.5"
                                           LineHeight="21">
                                    Du hast etwas kopiert und brauchst es zwei Minuten später wieder? Merkautomat hat es sich gemerkt. Er läuft leise im Hintergrund und holt dir mit einem Tastendruck zurück, was du suchst.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <StackPanel.Resources>
                                    <Style x:Key="AboutBenefitDot" TargetType="Border">
                                        <Setter Property="Width" Value="7" />
                                        <Setter Property="Height" Value="7" />
                                        <Setter Property="CornerRadius" Value="3.5" />
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="Margin" Value="0,7,12,0" />
                                    </Style>
                                    <Style x:Key="AboutBenefitTitle" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13.5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Margin" Value="0,0,0,2" />
                                    </Style>
                                    <Style x:Key="AboutBenefitText" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12.5" />
                                        <Setter Property="Opacity" Value="0.7" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="LineHeight" Value="19" />
                                    </Style>
                                </StackPanel.Resources>

                                <DockPanel Margin="0,0,0,14">
                                    <Border Style="{StaticResource AboutBenefitDot}" />
                                    <StackPanel>
                                        <TextBlock Text="Schneller wiederfinden" Style="{StaticResource AboutBenefitTitle}" />
                                        <TextBlock Text="Text, Bilder, Links und Code: einfach eintippen, woran du dich erinnerst."
                                                   Style="{StaticResource AboutBenefitText}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Border Style="{StaticResource AboutBenefitDot}" />
                                    <StackPanel>
                                        <TextBlock Text="Gedanken festhalten" Style="{StaticResource AboutBenefitTitle}" />
                                        <TextBlock Text="Sprich eine Idee einfach ein, Merkautomat schreibt sie für dich auf."
                                                   Style="{StaticResource AboutBenefitText}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Border Style="{StaticResource AboutBenefitDot}" />
                                    <StackPanel>
                                        <TextBlock Text="Aus Schnipseln wird Wissen" Style="{StaticResource AboutBenefitTitle}" />
                                        <TextBlock Text="Im Ideenkombinat findest du Dinge auch dann, wenn dir das genaue Wort fehlt."
                                                   Style="{StaticResource AboutBenefitText}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource AboutBenefitDot}" />
                                    <StackPanel>
                                        <TextBlock Text="Bleibt bei dir" Style="{StaticResource AboutBenefitTitle}" />
                                        <TextBlock Text="Alles bleibt auf deinem Rechner, ohne Konto und ohne Cloud."
                                                   Style="{StaticResource AboutBenefitText}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                                <ui:Button Content="Zur Entstehung"
                                           Click="AboutStory_Click"
                                           FontSize="12"
                                           Padding="12,4"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"
                                           ToolTip="Bildergeschichte: wie Merkautomat entstanden ist" />
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="11.5"
                                           Opacity="0.5">
                                    <Run Text="Version " /><Run x:Name="AboutVersionLabel" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="1" VerticalAlignment="Center" Background="#40FFFFFF" />
                                    <TextBlock Grid.Column="1" Text="♥" FontSize="14"
                                               Foreground="#FFE34A4A" Margin="10,0" />
                                    <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                                            Background="#40FFFFFF" />
                                </Grid>
                                <TextBlock TextAlignment="Center" FontSize="11.5" Opacity="0.8">
                                    <Run Text="From Germany by Marco Seefeldt" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</ui:FluentWindow>
