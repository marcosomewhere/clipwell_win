<Window x:Class="Merkautomat.Views.CategorizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einordnen – Ideenkombinat" Icon="/Merkautomat;component/Assets/kb-icon-16.png"
        Width="1120" Height="780" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EditorChromeBrush}" Foreground="{DynamicResource OnboardingTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrainDialogResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="Heading" Text="Einordnen" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="ScopeText" Style="{StaticResource BrainCaption}" Margin="0,5,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Vorschläge von" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="SourceBox" Width="330" SelectionChanged="SourceBox_SelectionChanged" AutomationProperties.Name="Vorschläge von"
                          ToolTip="Gilt nur für dieses Fenster; die Einstellung in der Kontrollstation bleibt unverändert." />
            </StackPanel>
            <TextBlock x:Name="ModelText" Style="{StaticResource BrainCaption}" Margin="0,6,0,0" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*" MinWidth="380"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource BrainCard}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Einträge" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="CountText" Style="{StaticResource BrainCaption}" Margin="0,4,0,8" />
                        <WrapPanel>
                            <CheckBox x:Name="OnlyUncategorized" Content="Nur ohne Kategorie" Style="{StaticResource EditorCheckBoxStyle}"
                                      Click="OnlyUncategorized_Click" Margin="0,0,12,6" VerticalAlignment="Center"
                                      ToolTip="Weiter springt nur zu Einträgen ohne gespeicherte Kategorie" />
                            <Button Content="Alle markieren" Click="MarkAll_Click" Style="{StaticResource EditorButtonStyle}" FontSize="12" Padding="8,5" Margin="0,0,6,6" />
                            <Button Content="Markierung aufheben" Click="MarkNone_Click" Style="{StaticResource EditorButtonStyle}" FontSize="12" Padding="8,5" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource BrainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                             SelectionChanged="ItemList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox AutomationProperties.Name="Für das gemeinsame Einordnen markieren" IsChecked="{Binding Marked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BrainSourceCheck}"
                                          Click="Mark_Click" ToolTip="Für das gemeinsame Einordnen markieren">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source.Title}" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource OnboardingAccentBrush}" />
                                        <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource EditorMutedBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="{DynamicResource EditorBorderBrush}" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="GroupCard" Style="{StaticResource BrainCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="GroupHeader" Text="Markierte gemeinsam einordnen" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="GroupStatus" Style="{StaticResource BrainCaption}" Margin="0,4,0,8" MaxHeight="52" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <WrapPanel x:Name="GroupCandidatePanel" Margin="0,0,0,6" />
                        <WrapPanel x:Name="GroupSubCandidatePanel" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="GroupCategory" IsEditable="True" ToolTip="Hauptkategorie für alle markierten Einträge" AutomationProperties.Name="Hauptkategorie für Markierte" />
                                <ComboBox x:Name="GroupSubcategory" Grid.Column="1" IsEditable="True" Margin="8,0,0,0" AutomationProperties.Name="Unterkategorie für Markierte"
                                          ToolTip="Unterkategorie (optional), auch als „Unter › Fein“; gehört zur Hauptkategorie links" />
                            </Grid>
                            <Button x:Name="GroupSuggestButton" Grid.Column="1" Content="Gemeinsam vorschlagen" Click="GroupSuggest_Click" Style="{StaticResource EditorButtonStyle}" Margin="8,0,0,0" />
                            <Button x:Name="GroupApplyButton" Grid.Column="2" Content="Allen Markierten zuordnen" Click="GroupApply_Click" Style="{StaticResource EditorButtonStyle}" Margin="8,0,0,0" />
                            <Button x:Name="GroupAnalyzeButton" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"
                                    Content="Markierte mit Sprachmodell analysieren …" Click="GroupAnalyze_Click" Style="{StaticResource EditorButtonStyle}"
                                    ToolTip="Markierte Einträge nach Inhalt gruppieren und vom gewählten Sprachmodell benennen lassen; auch zum Neu-Einordnen bereits zugeordneter Einträge" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource BrainCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="ItemTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ItemMeta" Style="{StaticResource BrainCaption}" Margin="0,4,0,10" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBlock x:Name="SuggestionText" Style="{StaticResource BrainCaption}" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <WrapPanel x:Name="CandidatePanel" Margin="0,0,0,6" />
                            <WrapPanel x:Name="SubCandidatePanel" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Hauptkategorie" Style="{StaticResource BrainCaption}" />
                                <TextBlock Grid.Column="1" Text="Unter- und Feinkategorie (optional)" Style="{StaticResource BrainCaption}" Margin="8,0,0,0" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ItemCategory" IsEditable="True" ToolTip="Hauptkategorie wählen oder neu eingeben" AutomationProperties.Name="Hauptkategorie"
                                          PreviewKeyDown="ItemCategory_PreviewKeyDown" />
                                <ComboBox x:Name="ItemSubcategory" Grid.Column="1" IsEditable="True" Margin="8,0,0,0" AutomationProperties.Name="Unterkategorie"
                                          ToolTip="„Unter“ oder „Unter › Fein“ wählen oder neu eingeben; gehört zur Hauptkategorie links" PreviewKeyDown="ItemCategory_PreviewKeyDown" />
                                <Button x:Name="ResuggestButton" Grid.Column="2" Content="Neu vorschlagen" Click="Resuggest_Click" Style="{StaticResource EditorButtonStyle}" Margin="8,0,0,0" />
                                <Button x:Name="SkipButton" Grid.Column="3" Content="Überspringen" Click="Skip_Click" Style="{StaticResource EditorButtonStyle}" Margin="8,0,0,0" />
                                <Button x:Name="ApplyButton" Grid.Column="4" Content="Zuordnen und weiter" Click="Apply_Click" Style="{StaticResource BrainPrimaryButton}" Margin="8,0,0,0"
                                        ToolTip="Kategorie speichern und zum nächsten offenen Eintrag (Enter)" />
                            </Grid>
                        </StackPanel>
                        <TextBox x:Name="ItemPreview" Style="{StaticResource BrainInput}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Feedback" Style="{StaticResource BrainCaption}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Grid.Column="1" Content="Schließen" IsCancel="True" Style="{StaticResource EditorButtonStyle}" />
        </Grid>
    </Grid>
</Window>
